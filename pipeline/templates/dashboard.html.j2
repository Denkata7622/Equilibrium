// ═══════════════════════════════════════════════════════════════
// TAB SWITCHING
// ═══════════════════════════════════════════════════════════════
const TAB_ORDER = ['overview', 'extraction', 'articles', 'costs', 'provider', 'logs', 'tools'];

function switchTab(tabName) {
  document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
  document.querySelectorAll('.tab-panel').forEach(p => p.classList.remove('active'));
  const tab = document.querySelector(`.tab[data-tab="${tabName}"]`);
  if (tab) tab.classList.add('active');
  const panel = $('tab-' + tabName);
  if (panel) panel.classList.add('active');

  // Auto-trigger data loads on tab open
  if (tabName === 'articles' && !S.articles.length) fetchArticles().then(renderArticlesTab);
  if (tabName === 'extraction') {
    if (!S.chunkerStats && !S.chunkerStatsAt) {
      // Auto-run stats on first visit
      setTimeout(() => autoRunChunkerStats(), 100);
    } else {
      renderExtractionTab();
    }
  }
  if (tabName === 'costs') renderCostsTab();
  if (tabName === 'provider') renderProviderTab();
  if (tabName === 'logs') renderLogsTab();
  icons();
}

document.querySelectorAll('.tab').forEach(tab => {
  tab.addEventListener('click', () => switchTab(tab.dataset.tab));
});

document.addEventListener('keydown', (e) => {
  if (e.target.matches('input, textarea, select')) return;
  if (e.metaKey || e.ctrlKey || e.altKey) return;
  const idx = parseInt(e.key) - 1;
  if (idx >= 0 && idx < TAB_ORDER.length) {
    e.preventDefault();
    switchTab(TAB_ORDER[idx]);
  }
});

// ═══════════════════════════════════════════════════════════════
// FETCHERS (with abort)
// ═══════════════════════════════════════════════════════════════
const _aborts = {};

async function fetchJSON(url, opts = {}) {
  const key = url.split('?')[0];
  if (_aborts[key]) _aborts[key].abort();
  _aborts[key] = new AbortController();
  try {
    const r = await fetch(url, { signal: _aborts[key].signal, ...opts });
    if (!r.ok) {
      const txt = await r.text().catch(() => '');
      throw new Error(`HTTP ${r.status}${txt ? ': ' + txt.slice(0, 100) : ''}`);
    }
    return await r.json();
  } finally {
    // abort handled on next call
  }
}

async function fetchState() {
  try { S.state = await fetchJSON('/api/state'); S.lastFetch.state = Date.now(); }
  catch (e) { if (e.name !== 'AbortError') console.error('state', e); }
}
async function fetchQueue() {
  try { S.queue = await fetchJSON('/api/queue'); S.lastFetch.queue = Date.now(); }
  catch (e) { if (e.name !== 'AbortError') console.error('queue', e); }
}
async function fetchCostsAll() {
  try { S.costs = await fetchJSON('/api/costs/all'); S.lastFetch.costs = Date.now(); }
  catch (e) {
    try { S.costs = await fetchJSON('/api/costs/recent?n=500'); }
    catch (e2) { S.costs = []; }
  }
}
async function fetchOrch() {
  try {
    const d = await fetchJSON('/api/orchestrator/status');
    S.running = d.running;
    const st = $('status');
    st.classList.remove('running', 'error');
    if (d.running) {
      st.classList.add('running');
      $('statusText').textContent = 'Running';
      $('btnStart').disabled = true;
      $('btnStop').disabled = false;
      $('mPid').textContent = d.pid;
      $('mUptime').textContent = uptime(d.uptime_sec || 0);
      S.uptimeBase = Date.now() - (d.uptime_sec || 0) * 1000;
    } else {
      $('statusText').textContent = 'Idle';
      $('btnStart').disabled = false;
      $('btnStop').disabled = true;
      $('mPid').textContent = '—';
      $('mUptime').textContent = '—';
      S.uptimeBase = null;
    }
  } catch (e) {
    if (e.name !== 'AbortError') {
      $('status').classList.add('error');
      $('statusText').textContent = 'Offline';
    }
  }
}
async function fetchArticles() {
  try { S.articles = await fetchJSON('/api/articles'); S.lastFetch.articles = Date.now(); }
  catch (e) { if (e.name !== 'AbortError') console.error('articles', e); }
}
async function fetchLog(sourceOverride = null) {
  const src = sourceOverride || S.logSource || 'chunker';
  try {
    const d = await fetchJSON(`/api/logs/tail?lines=500&source=${encodeURIComponent(src)}`);
    S.log = (d.lines || []).map(l => l.replace(/\r?\n$/, ''));
    S.lastFetch.log = Date.now();
    S.logSourceActive = src;
    S.chunkerProgress = parseExtractionProgress();
  } catch (e) {
    if (e.name !== 'AbortError') S.log = [];
  }
}
async function fetchProviderCosts(force = false) {
  if (!force && S.providerCosts && !Array.isArray(S.providerCosts) && Object.keys(S.providerCosts).length) return;
  const urls = ['/api/costs/combined', '/generated/costs/combined.json', '/combined.json'];
  for (const url of urls) {
    try {
      const d = await fetchJSON(url);
      if (d && typeof d === 'object' && !Array.isArray(d)) {
        S.providerCosts = d;
        S.lastFetch.providerCosts = Date.now();
        return;
      }
    } catch (e) { /* next */ }
  }
  if (!S.providerCosts || Array.isArray(S.providerCosts)) S.providerCosts = {};
}

// ═══════════════════════════════════════════════════════════════
// EXTRACTION PROGRESS (from logs)
// ═══════════════════════════════════════════════════════════════
function parseExtractionProgress() {
  if (!S.log.length) return null;

  let currentPdf = null;
  let currentIdx = 0, currentTotal = 0;
  let segmentsDone = 0, segmentsTotal = 0;
  let budgetExhausted = false;
  let lastActivityAt = 0;

  for (let i = S.log.length - 1; i >= 0; i--) {
    const line = S.log[i];
    if (/Бюджет достигнат|BudgetExhausted/.test(line)) budgetExhausted = true;

    let m = line.match(/═══\s+(.+?)\s+═══/);
    if (m && !currentPdf) { currentPdf = m[1]; if (!lastActivityAt) lastActivityAt = i; continue; }

    m = line.match(/\[(\d+)\/(\d+)\]\s+(.+?)\.pdf/);
    if (m && !currentTotal) { currentTotal = parseInt(m[2]); currentIdx = parseInt(m[1]); continue; }

    m = line.match(/segmented:\s+(\d+)\s+problems from (\d+)\s+segments/);
    if (m && !segmentsTotal) { segmentsTotal = parseInt(m[2]); segmentsDone = segmentsTotal; continue; }

    if (/seg\s+[\d.]+:\s+\d+\s+problems/.test(line) && !segmentsTotal) { segmentsDone++; continue; }

    if (/verdict=(PASS|PASS_WITH_WARNINGS|FAIL_)/.test(line)) {
      if (currentPdf && segmentsTotal === 0) segmentsTotal = segmentsDone;
    }
  }

  if (!currentPdf && !currentIdx) return null;
  const active = !!currentPdf && !budgetExhausted && currentIdx > 0;

  return {
    currentPdf, currentIdx, currentTotal, segmentsDone, segmentsTotal,
    budgetExhausted, isRunning: active,
  };
}

// ═══════════════════════════════════════════════════════════════
// OVERVIEW RENDER
// ═══════════════════════════════════════════════════════════════
function renderOverview() {
  if (!S.state) return;

  const st = S.state.stats || {};
  const todayKey = new Date().toISOString().slice(0, 10);
  const providerCombined = (S.providerCosts && !Array.isArray(S.providerCosts)) ? S.providerCosts : null;
  const liveToday = providerCombined ? (providerCombined.by_day || {})[todayKey] : null;
  const legacyToday = S.costs.filter(c => tsDay(c.ts) === todayKey);
  const legacySpent = legacyToday.reduce((a, c) => a + (c.cost || 0), 0);
  const todaySpent = (liveToday && liveToday.cost > 0) ? liveToday.cost : legacySpent;
  const todayCalls = (liveToday && liveToday.calls > 0) ? liveToday.calls : legacyToday.length;

  $('kDone').textContent = st.done || 0;
  $('kDoneSub').textContent = `of ${S.queue.total || 0} · ${Math.round((st.done || 0) / Math.max(1, S.queue.total || 1) * 100)}%`;
  $('kPending').textContent = S.queue.pending?.length || 0;
  $('kErrors').textContent = st.error || 0;
  $('kErrorsSub').textContent = st.error ? 'needs attention' : 'all clear';
  $('kScore').textContent = st.scores?.avg || '—';
  $('kScoreSub').textContent = st.scores?.max ? `${st.scores.min}–${st.scores.max} range` : 'no scores';
  $('kSpent').textContent = money(todaySpent);
  const pct = todaySpent / 3;
  $('kSpent').className = 'kpi-v' + (pct >= 0.9 ? ' danger' : pct >= 0.75 ? ' warn' : '');

  const parts = [`of $3.00`, `${todayCalls} calls`];
  if (liveToday?.reasoning_tokens) parts.push(`${bigNum(liveToday.reasoning_tokens)} reasoning`);
  $('kSpentSub').textContent = parts.join(' · ');
  $('mBudget').textContent = `${moneyShort(todaySpent)}/3.00`;

  // Score dist
  const dist = st.scores?.distribution || {};
  const keys = Object.keys(dist).map(Number).sort((a, b) => b - a);
  if (!keys.length) {
    $('distBody').innerHTML = '<div class="empty"><i data-lucide="bar-chart-2"></i>No scores yet</div>';
    $('distBadge').textContent = '—';
  } else {
    const max = Math.max(...Object.values(dist));
    const tot = Object.values(dist).reduce((a, b) => a + b, 0);
    $('distBody').innerHTML = keys.map(sc => {
      const c = dist[sc];
      const w = Math.round(c / max * 100);
      const cls = sc >= 8 ? 'hi' : sc >= 6 ? 'mid' : sc >= 4 ? 'lo' : 'bad';
      return `<div class="dist-item">
        <span class="dist-label">${sc}/10</span>
        <div class="dist-track"><div class="dist-fill ${cls}" style="width:${w}%"></div></div>
        <span class="dist-count">${c}</span>
      </div>`;
    }).join('');
    $('distBadge').textContent = `${tot} total`;
  }
  $('distUpdated').textContent = S.lastFetch.state ? fmtTs(S.lastFetch.state) : '';

  renderRecentArticles();

  $('queueBadge').textContent = `${S.queue.pending?.length || 0}/${S.queue.total || 0}`;
  if (!S.queue.pending?.length) {
    $('queueTable').querySelector('tbody').innerHTML = '<tr><td colspan="3" class="empty"><i data-lucide="list"></i>Queue empty</td></tr>';
  } else {
    $('queueTable').querySelector('tbody').innerHTML = S.queue.pending.slice(0, 10).map(p =>
      `<tr>
        <td class="mono">${esc(p.id)}</td>
        <td class="text">${esc((p.title || '').slice(0, 50))}</td>
        <td style="text-align:right"><a class="row-action" href="/article/${esc(p.id)}" target="_blank"><i data-lucide="arrow-up-right"></i></a></td>
      </tr>`
    ).join('');
  }

  $('tabArticlesBadge').textContent = st.done || 0;
  renderExtractionPulse();
  icons();
}

function renderExtractionPulse() {
  const p = S.chunkerProgress;
  const container = $('extractionPulse');
  if (!container) return;
  if (!p || (!p.currentPdf && !p.currentTotal)) { container.innerHTML = ''; return; }

  if (p.isRunning) {
    const pct = p.segmentsTotal > 0 ? Math.round((p.segmentsDone / p.segmentsTotal) * 100) : 0;
    container.innerHTML = `
      <div class="progress-live" style="margin-bottom:12px">
        <div class="pl-icon"><i data-lucide="loader-2" class="spin"></i></div>
        <div class="pl-body">
          <div class="pl-title">Extracting: <span class="mono">${esc(p.currentPdf || '?')}</span></div>
          <div class="pl-sub">${p.currentIdx}/${p.currentTotal} · segments ${p.segmentsDone}/${p.segmentsTotal} · ${pct}%</div>
          <div class="progress-bar"><div class="progress-fill" style="width:${pct}%"></div></div>
        </div>
        <button class="btn sm" onclick="switchTab('extraction')">Details →</button>
      </div>`;
    icons();
  } else if (p.budgetExhausted) {
    container.innerHTML = `
      <div class="progress-live error" style="margin-bottom:12px">
        <div class="pl-icon"><i data-lucide="alert-triangle"></i></div>
        <div class="pl-body">
          <div class="pl-title">Extraction halted — budget exhausted</div>
          <div class="pl-sub">Stopped at ${p.currentIdx}/${p.currentTotal}. Resets at midnight UTC.</div>
        </div>
        <button class="btn sm" onclick="switchTab('extraction')">Details →</button>
      </div>`;
    icons();
  } else { container.innerHTML = ''; }
}

function renderRecentArticles() {
  const recent = [...S.articles]
    .filter(a => a.status === 'done')
    .sort((a, b) => (b.ts || 0) - (a.ts || 0))
    .slice(0, 10);
  $('recentBadge').textContent = `${S.articles.filter(a => a.status === 'done').length} total`;
  if (!recent.length) {
    $('recentTable').querySelector('tbody').innerHTML = '<tr><td colspan="5" class="empty"><i data-lucide="file-text"></i>No articles yet</td></tr>';
  } else {
    $('recentTable').querySelector('tbody').innerHTML = recent.map(a => {
      const sc = a.score;
      const cls = sc == null ? 's0' : sc >= 8 ? 's8' : sc >= 6 ? 's6' : sc >= 4 ? 's4' : 's0';
      return `<tr>
        <td class="mono">${esc(a.id)}</td>
        <td class="text">${esc((a.title || '').slice(0, 50))}</td>
        <td><span class="score-pill ${cls}">${sc ?? '—'}</span></td>
        <td class="mono">${a.word_count || '—'}</td>
        <td style="text-align:right"><a class="row-action" href="/article/${esc(a.id)}" target="_blank"><i data-lucide="arrow-up-right"></i></a></td>
      </tr>`;
    }).join('');
  }
}

// ═══════════════════════════════════════════════════════════════
// EXTRACTION RENDER
// ═══════════════════════════════════════════════════════════════
function renderExtractionTab() {
  const stats = S.chunkerStats;
  const p = S.chunkerProgress;
  const running = p?.isRunning;
  const budgetExhausted = p?.budgetExhausted;

  // ─── Phase pipeline ───
  const phaseData = stats ? {
    extract: { count: stats.extracted.pdfs, label: `${stats.extracted.pdfs} PDFs · ${bigNum(stats.extracted.problems)} problems` },
    merge: { count: stats.merged.olympiads, label: stats.merged.olympiads ? `${stats.merged.olympiads} olympiads` : 'not run' },
    classify: { count: stats.classified.olympiads, label: stats.classified.olympiads ? `${stats.classified.olympiads} items · ${bigNum(stats.classified.problems)} problems` : 'not run' },
    aggregate: { count: stats.realProblems.total, label: stats.realProblems.points ? `${stats.realProblems.points} points · ${stats.realProblems.total} problems` : 'not run' },
  } : null;

  document.querySelectorAll('.phase-step').forEach(step => {
    step.classList.remove('done', 'running', 'error');
    const phase = step.dataset.phase;
    if (phase === 'extract' && running) step.classList.add('running');
    else if (phase === 'extract' && budgetExhausted) step.classList.add('error');
    else if (phaseData && phaseData[phase]?.count > 0) step.classList.add('done');
  });

  if (phaseData) {
    $('phaseExtractMeta').textContent = running ? `Running: ${p.currentIdx}/${p.currentTotal}` : phaseData.extract.label;
    $('phaseMergeMeta').textContent = phaseData.merge.label;
    $('phaseClassifyMeta').textContent = phaseData.classify.label;
    $('phaseAggregateMeta').textContent = phaseData.aggregate.label;
  } else {
    ['phaseExtractMeta', 'phaseMergeMeta', 'phaseClassifyMeta', 'phaseAggregateMeta'].forEach(id => {
      $(id).textContent = running && id === 'phaseExtractMeta' ? `Running: ${p.currentIdx}/${p.currentTotal}` : '—';
    });
  }

  // ─── Live progress ───
  const plEl = $('progressLive');
  plEl.classList.remove('idle', 'error');
  if (running) {
    const pct = p.segmentsTotal > 0 ? Math.round((p.segmentsDone / p.segmentsTotal) * 100) : 0;
    $('plTitle').innerHTML = `Extracting · <span class="mono" style="color:var(--warn);font-size:11px">${esc(p.currentPdf)}</span>`;
    $('plSub').textContent = `${p.currentIdx}/${p.currentTotal} · segments ${p.segmentsDone}/${p.segmentsTotal} · ${pct}%`;
    $('plFill').style.width = pct + '%';
  } else if (budgetExhausted) {
    plEl.classList.add('error');
    $('plTitle').textContent = 'Budget exhausted';
    $('plSub').textContent = `Stopped at ${p.currentIdx}/${p.currentTotal}. Resets at midnight UTC.`;
    $('plFill').style.width = '0%';
  } else {
    plEl.classList.add('idle');
    $('plTitle').textContent = stats ? 'Extraction idle' : 'Extraction idle — click "Stats" to load data';
    $('plSub').textContent = stats
      ? `Last stats loaded ${fmtTs(S.chunkerStatsAt)}`
      : 'No active extraction detected in logs.';
    $('plFill').style.width = '0%';
  }

  // ─── KPIs ───
  if (stats) {
    $('exPdfs').textContent = stats.extracted.pdfs;
    $('exPdfsSub').textContent = stats.extracted.partial > 0 ? `${stats.extracted.partial} partial` : 'all complete';
    $('exProblems').textContent = bigNum(stats.extracted.problems);
    $('exProblemsSub').textContent = stats.extracted.pdfs > 0 ? `avg ${(stats.extracted.problems / stats.extracted.pdfs).toFixed(1)}/PDF` : '—';
    $('exReal').textContent = stats.realProblems.total;
    $('exRealSub').textContent = `across ${stats.realProblems.points} points`;
    $('exBudget').textContent = moneyShort(stats.cost);
    $('exBudgetSub').textContent = `total chunker cost`;
    const pct = stats.cost / 3;
    $('exBudget').className = 'kpi-v' + (pct >= 0.9 ? ' danger' : pct >= 0.75 ? ' warn' : '');
  } else {
    ['exPdfs', 'exProblems', 'exReal', 'exBudget'].forEach(id => $(id).textContent = '—');
    $('exPdfsSub').textContent = 'click "Stats"';
    $('exProblemsSub').textContent = 'extracted';
    $('exRealSub').textContent = 'across points';
    $('exBudgetSub').textContent = 'total';
  }

  // ─── Verdict breakdown ───
  const verdicts = stats?.verdicts || {};
  const totalVerdicts = Object.values(verdicts).reduce((a, b) => a + b, 0);
  if (!totalVerdicts) {
    $('verdictBody').innerHTML = `
      <div class="empty">
        <i data-lucide="shield-check"></i>
        <div>No verdict data yet</div>
        <div class="empty-actions">
          <button class="btn sm primary" onclick="runChunkerStats(this)">
            <i data-lucide="bar-chart-3"></i> Load Stats
          </button>
          <button class="btn sm" onclick="switchTab('logs')">
            <i data-lucide="terminal"></i> Open Logs
          </button>
        </div>
      </div>`;
    $('verdictBadge').textContent = '—';
  } else {
    const order = ['PASS', 'PASS_WITH_WARNINGS', 'unknown', 'FAIL_DUPLICATE', 'FAIL_MISSING', 'FAIL_HALLUCINATED'];
    const colors = { PASS: 'pass', PASS_WITH_WARNINGS: 'warn', unknown: 'unknown', FAIL_DUPLICATE: 'fail', FAIL_MISSING: 'fail', FAIL_HALLUCINATED: 'fail' };
    const labels = { PASS: 'PASS', PASS_WITH_WARNINGS: 'Warnings', unknown: 'Unknown', FAIL_DUPLICATE: 'Duplicate', FAIL_MISSING: 'Missing', FAIL_HALLUCINATED: 'Hallucinated' };
    const maxV = Math.max(...Object.values(verdicts), 1);
    $('verdictBody').innerHTML = order.filter(k => verdicts[k] > 0).map(v =>
      `<div class="breakdown-row">
        <span class="breakdown-label">${labels[v] || v}</span>
        <div class="breakdown-track"><div class="breakdown-fill ${colors[v] || 'unknown'}" style="width:${(verdicts[v] / maxV * 100).toFixed(1)}%"></div></div>
        <span class="breakdown-count">${verdicts[v]} · ${Math.round(verdicts[v] / totalVerdicts * 100)}%</span>
      </div>`
    ).join('');
    $('verdictBadge').textContent = `${totalVerdicts} sessions`;
  }

  // ─── Level breakdown ───
  const levels = stats?.levels || {};
  const totalLevels = Object.values(levels).reduce((a, b) => a + b, 0);
  if (!totalLevels) {
    $('levelBody').innerHTML = '<div class="empty"><i data-lucide="layers"></i>No level data — click "Stats"</div>';
    $('levelBadge').textContent = '—';
  } else {
    const order = ['L0_native', 'L1_ocr', 'L2_vlm', 'L3_escalation', 'exhausted', 'unknown'];
    const colors = { L0_native: 'l0', L1_ocr: 'l1', L2_vlm: 'l2', L3_escalation: 'l3', exhausted: 'exhausted', unknown: 'unknown' };
    const labels = { L0_native: 'L0 Native', L1_ocr: 'L1 OCR', L2_vlm: 'L2 VLM', L3_escalation: 'L3 Escalate', exhausted: 'Exhausted', unknown: 'Unknown' };
    const maxL = Math.max(...Object.values(levels), 1);
    $('levelBody').innerHTML = order.filter(k => levels[k] > 0).map(lv =>
      `<div class="breakdown-row">
        <span class="breakdown-label">${labels[lv] || lv}</span>
        <div class="breakdown-track"><div class="breakdown-fill ${colors[lv] || 'unknown'}" style="width:${(levels[lv] / maxL * 100).toFixed(1)}%"></div></div>
        <span class="breakdown-count">${levels[lv]} · ${Math.round(levels[lv] / totalLevels * 100)}%</span>
      </div>`
    ).join('');
    $('levelBadge').textContent = `${totalLevels} PDFs`;
    if (stats.needsReview > 0) $('levelBadge').textContent += ` · ${stats.needsReview} review`;
  }

  // ─── Point coverage ───
  renderPointCoverage();

  // ─── Model config (parse from logs) ───
  renderModelConfig();

  // ─── Tab badge ───
  $('tabExtractionBadge').textContent = stats ? stats.extracted.pdfs : '—';
  if (stats?.needsReview > 0) $('tabExtractionBadge').classList.add('warn');
  else $('tabExtractionBadge').classList.remove('warn');

  // ─── Recent extraction tool results ───
  renderExtractionHistory();

  // ─── Audit ───
  renderAuditVisual();

  icons();
}

function renderPointCoverage() {
  const stats = S.chunkerStats;
  const container = $('coverageBody');
  if (!stats || !Object.keys(stats.realProblems.byPoint).length) {
    container.innerHTML = '<div class="empty"><i data-lucide="grid-3x3"></i>Click "Stats" to load per-point counts</div>';
    $('coverageBadge').textContent = '—';
    return;
  }
  const byPoint = stats.realProblems.byPoint;
  const ids = Object.keys(byPoint).sort((a, b) => {
    const [a1, a2] = a.split('.').map(x => parseInt(x) || 0);
    const [b1, b2] = b.split('.').map(x => parseInt(x) || 0);
    if (a1 !== b1) return a1 - b1;
    return a2 - b2;
  });

  container.innerHTML = `<div class="point-coverage-grid">${ids.map(id => {
    const p = byPoint[id];
    const cls = p.total === 0 ? 'zero' : p.total < 3 ? 'few' : 'many';
    return `<div class="pc-cell ${cls}" title="${id}: ${p.easy} easy, ${p.medium} medium, ${p.hard} hard">
      <div class="pc-id">${esc(id)}</div>
      <div class="pc-count">${p.total}</div>
    </div>`;
  }).join('')}</div>`;

  $('coverageBadge').textContent = `${ids.length} points · ${stats.realProblems.total} problems`;
}

function renderModelConfig() {
  const body = $('modelConfigBody');
  // Parse from logs
  let classifyModel = '—', verifierModel = '—';
  for (let i = S.log.length - 1; i >= 0; i--) {
    const line = S.log[i];
    if (classifyModel === '—') {
      const m = line.match(/Classify model:\s*(\S+)/);
      if (m) classifyModel = m[1];
    }
    if (verifierModel === '—') {
      const m = line.match(/Verifier model:\s*(\S+)/);
      if (m) verifierModel = m[1];
    }
    if (classifyModel !== '—' && verifierModel !== '—') break;
  }
  // Extract (default from code, no log)
  const extractModel = 'deepseek/deepseek-v4.1-flash';
  const ocrModel = 'mistral-ocr-latest';

  body.innerHTML = `
    <div class="model-row"><span class="model-label">Extract</span><span class="model-value primary">${esc(extractModel)}</span></div>
    <div class="model-row"><span class="model-label">Classify</span><span class="model-value">${esc(classifyModel)}</span></div>
    <div class="model-row"><span class="model-label">Verifier</span><span class="model-value">${esc(verifierModel)}</span></div>
    <div class="model-row"><span class="model-label">OCR</span><span class="model-value">${esc(ocrModel)}</span></div>
    <div class="model-row"><span class="model-label">Budget</span><span class="model-value">$3.00/day · stop @ 90%</span></div>
  `;
}

function renderExtractionHistory() {
  const container = $('extractionToolResults');
  if (!S.extractionHistory.length) {
    container.innerHTML = '<div class="empty" style="padding:20px"><i data-lucide="history"></i>No recent runs</div>';
    return;
  }
  container.innerHTML = S.extractionHistory.slice(0, 5).map((r, idx) => {
    const ok = r.data.status === 'completed';
    const output = r.data.stdout || r.data.stderr || r.data.error || '(no output)';
    const short = output.length > 500 ? output.slice(0, 500) + '\n…' : output;
    return `<div class="tool-result" data-idx="${idx}">
      <div class="tool-result-h">
        <i data-lucide="${ok ? 'check-circle-2' : 'alert-circle'}"></i>
        <span class="${ok ? 'status-ok' : 'status-err'}"><strong>${esc(r.name)}</strong> — ${esc(r.data.status || 'unknown')}</span>
        <span class="meta">${fmtTs(r.at)}</span>
        <button class="close-r" onclick="removeExtractionHistory(${idx})"><i data-lucide="x"></i></button>
      </div>
      <div class="tool-result-b">${esc(short)}</div>
    </div>`;
  }).join('');
  icons();
}

function removeExtractionHistory(idx) {
  S.extractionHistory.splice(idx, 1);
  renderExtractionHistory();
}

function clearExtractionResults() {
  S.extractionHistory = [];
  renderExtractionHistory();
}

function clearToolResults() {
  S.toolHistory = [];
  const el = $('toolResults');
  if (el) el.innerHTML = '';
}

// ═══════════════════════════════════════════════════════════════
// AUDIT VISUAL (grouped, with charts)
// ═══════════════════════════════════════════════════════════════
function renderAuditVisual() {
  const container = $('auditVisualBody');
  if (!S.chunkerAudit.length) {
    container.innerHTML = `
      <div class="empty">
        <i data-lucide="table"></i>
        <div>PDF audit not loaded</div>
        <div class="empty-actions">
          <button class="btn sm primary" onclick="runChunkerAudit(this)">
            <i data-lucide="scan-line"></i> Load Audit
          </button>
          <span class="mono" style="font-size:10px;color:var(--text-4);align-self:center">runs <code>pdf_chunker.py --audit</code></span>
        </div>
      </div>`;
    $('auditBadge').textContent = '—';
    return;
  }

  const q = S.auditSearch.toLowerCase();
  let filtered = S.chunkerAudit.filter(row => {
    if (S.auditFilter === 'ok' && row.status !== 'OK') return false;
    if (S.auditFilter === 'warn' && !row.status.includes('LOW') && !row.status.includes('NO_TEXT') && !row.status.includes('OCR')) return false;
    if (S.auditFilter === 'empty' && !row.status.includes('EMPTY')) return false;
    if (q && !(row.pdf || '').toLowerCase().includes(q)) return false;
    return true;
  });

  $('auditBadge').textContent = `${filtered.length}/${S.chunkerAudit.length}`;
  $('auditUpdated').textContent = S.chunkerAuditAt ? fmtTSafe(S.chunkerAuditAt) : '';

  if (!filtered.length) {
    container.innerHTML = '<div class="empty">No matching PDFs</div>';
    return;
  }

  // Group by olympiad
  const groups = {};
  filtered.forEach(row => {
    const g = groupPdfByOlympiad(row.pdf);
    if (!groups[g]) groups[g] = [];
    groups[g].push(row);
  });

  const groupNames = Object.keys(groups).sort();
  const maxProb = Math.max(...filtered.map(r => r.problems), 1);

  let html = '';
  for (const g of groupNames) {
    const rows = groups[g];
    const totalProb = rows.reduce((a, r) => a + r.problems, 0);
    html += `<div class="audit-group-header">
      <i data-lucide="folder" style="width:12px;height:12px"></i>
      ${esc(g)}
      <span class="count">${rows.length} PDFs · ${totalProb} problems</span>
    </div>`;
    for (const row of rows) {
      const statusCls = row.status.includes('EMPTY') ? 'empty' : row.status === 'OK' ? 'ok' : 'warn';
      const barWidth = Math.max(8, Math.round((row.problems / maxProb) * 100));
      html += `<div class="audit-row-visual" title="${esc(row.pdf)} · ${row.pages}p · ${row.problems} problems · ${row.status}">
        <div class="arv-name" title="${esc(row.pdf)}">${esc(row.pdf)}</div>
        <div class="arv-group">${esc(groupPdfByOlympiad(row.pdf).split(' ').slice(-1)[0] || '—')}</div>
        <div class="arv-pages">${row.pages}p</div>
        <div class="arv-chart">
          <div class="bar ${row.problems === 0 ? 'empty' : 'easy'}" style="max-width:${barWidth}%"></div>
        </div>
        <div class="arv-problems">${row.problems}</div>
        <div class="arv-status ${statusCls}">${esc(row.status)}</div>
      </div>`;
    }
  }
  container.innerHTML = html;
  icons();
}

function fmtTSafe(ts) {
  try { return new Date(ts).toLocaleTimeString('bg-BG'); } catch { return ''; }
}

// ═══════════════════════════════════════════════════════════════
// ARTICLES
// ═══════════════════════════════════════════════════════════════
function renderArticlesTab() {
  if (!S.articles.length) {
    fetchArticles().then(() => renderArticlesTab());
    return;
  }
  const q = S.artSearch.toLowerCase().trim();
  const filter = S.artVerdict;

  const counts = {
    all: S.articles.length,
    approve: S.articles.filter(a => a.verdict === 'approve').length,
    revise: S.articles.filter(a => a.verdict === 'revise').length,
    reject: S.articles.filter(a => a.verdict === 'reject').length,
    error: S.articles.filter(a => a.status === 'error').length,
  };
  Object.entries(counts).forEach(([k, v]) => {
    const el = document.querySelector(`[data-count="${k}"]`);
    if (el) el.textContent = v;
  });

  let filtered = S.articles.filter(a => {
    if (filter === 'approve' && a.verdict !== 'approve') return false;
    if (filter === 'revise' && a.verdict !== 'revise') return false;
    if (filter === 'reject' && a.verdict !== 'reject') return false;
    if (filter === 'error' && a.status !== 'error') return false;
    if (q) {
      const hay = ((a.id || '') + ' ' + (a.title || '')).toLowerCase();
      if (!hay.includes(q)) return false;
    }
    return true;
  });

  const { key, desc } = S.artSort;
  filtered.sort((a, b) => {
    let av = a[key], bv = b[key];
    if (key === 'ts') { av = av || 0; bv = bv || 0; }
    if (av == null) av = -Infinity;
    if (bv == null) bv = -Infinity;
    if (av < bv) return desc ? 1 : -1;
    if (av > bv) return desc ? -1 : 1;
    return 0;
  });

  document.querySelectorAll('.sort-ind').forEach(el => el.textContent = '');
  const ind = document.querySelector(`[data-ind="${key}"]`);
  if (ind) ind.textContent = desc ? '↓' : '↑';

  $('artCount').textContent = `${filtered.length} of ${S.articles.length}`;

  const tb = $('artBody');
  if (!filtered.length) {
    tb.innerHTML = '<tr><td colspan="9" class="empty"><i data-lucide="file-text"></i>No matching articles</td></tr>';
    icons();
    return;
  }
  tb.innerHTML = filtered.map(a => {
    const sc = a.score;
    const scCls = sc == null ? 's0' : sc >= 8 ? 's8' : sc >= 6 ? 's6' : sc >= 4 ? 's4' : 's0';
    const v = a.verdict || a.status || '—';
    return `<tr data-id="${esc(a.id)}">
      <td class="mono">${esc(a.id)}</td>
      <td class="text" title="${esc(a.title || '')}">${esc((a.title || '').slice(0, 55))}</td>
      <td style="text-align:right"><span class="score-pill ${scCls}">${sc ?? '—'}</span></td>
      <td><span class="verdict-pill ${v === 'error' ? 'error' : v}">${v}</span></td>
      <td class="mono" style="text-align:right">${a.word_count || '—'}</td>
      <td class="mono" style="text-align:right">${a.attempts || '—'}</td>
      <td class="mono" style="text-align:right">${a.cost ? moneyShort(a.cost) : '—'}</td>
      <td class="mono" style="text-align:right">${timeAgo(a.ts)}</td>
      <td>
        <div class="row-actions">
          <a class="row-action primary" href="/article/${esc(a.id)}" target="_blank" title="Open"><i data-lucide="arrow-up-right"></i></a>
          <button class="row-action" title="Verify" onclick="quickVerify('${esc(a.id)}', this)"><i data-lucide="shield-check"></i></button>
          <button class="row-action danger" title="Reset" onclick="quickReset('${esc(a.id)}', this)"><i data-lucide="rotate-ccw"></i></button>
        </div>
      </td>
    </tr>`;
  }).join('');
  icons();
}

// ═══════════════════════════════════════════════════════════════
// COSTS
// ═══════════════════════════════════════════════════════════════
function renderCostsTab() {
  const now = new Date();
  const today = now.toISOString().slice(0, 10);
  const weekAgo = new Date(now.getTime() - 7 * 86400000).toISOString().slice(0, 10);

  const combined = (S.providerCosts && !Array.isArray(S.providerCosts)) ? S.providerCosts : null;
  const cByDay = combined ? (combined.by_day || {}) : {};
  const cByModel = combined ? (combined.by_model || {}) : {};
  const cByRole = combined ? (combined.by_role || {}) : {};
  const cTotals = combined ? (combined.totals || {}) : {};

  const legacyByDay = {};
  S.costs.forEach(c => {
    const d = tsDay(c.ts);
    if (!d) return;
    if (!legacyByDay[d]) legacyByDay[d] = { calls: 0, tokens: 0, cost: 0 };
    legacyByDay[d].calls++;
    legacyByDay[d].tokens += c.tokens || 0;
    legacyByDay[d].cost += c.cost || 0;
  });

  const hasCombined = Object.keys(cByDay).length > 0;
  const hasLegacy = Object.keys(legacyByDay).length > 0;

  if (!hasCombined && !hasLegacy) {
    $('cToday').textContent = '$0';
    $('cTodaySub').textContent = '0 calls · ledger stale';
    $('cWeek').textContent = '$0';
    $('cWeekSub').textContent = '0 calls';
    $('cAll').textContent = '$0';
    $('cAllSub').textContent = '0 calls';
    $('byModelTable').querySelector('tbody').innerHTML = '<tr><td colspan="4" class="empty">No data — run cost_aggregate.py</td></tr>';
    $('byRoleTable').querySelector('tbody').innerHTML = '<tr><td colspan="4" class="empty">No data</td></tr>';
    $('recentCallsBody').innerHTML = '<tr><td colspan="6" class="empty">No calls yet</td></tr>';
    return;
  }

  const daySet = new Set([...Object.keys(cByDay), ...Object.keys(legacyByDay)]);
  const merged = {};
  daySet.forEach(d => {
    const c = cByDay[d] || null;
    const l = legacyByDay[d] || null;
    if (c && c.cost >= (l?.cost || 0)) merged[d] = c;
    else if (l) merged[d] = l;
  });

  const todayEntry = merged[today] || { calls: 0, tokens: 0, cost: 0 };
  const weekTotal = Object.entries(merged)
    .filter(([d]) => d >= weekAgo)
    .reduce((a, [_, v]) => ({ calls: a.calls + v.calls, tokens: a.tokens + v.tokens, cost: a.cost + v.cost }), { calls: 0, tokens: 0, cost: 0 });
  const allTotal = Object.values(merged).reduce(
    (a, v) => ({ calls: a.calls + v.calls, tokens: a.tokens + v.tokens, cost: a.cost + v.cost }), { calls: 0, tokens: 0, cost: 0 });

  $('cToday').textContent = moneyShort(todayEntry.cost);
  $('cTodaySub').textContent = `${todayEntry.calls} calls`;
  $('cWeek').textContent = moneyShort(weekTotal.cost);
  $('cWeekSub').textContent = `${weekTotal.calls} calls`;
  $('cAll').textContent = moneyShort(allTotal.cost);
  $('cAllSub').textContent = `${allTotal.calls} calls`;

  const days = {};
  for (let i = 13; i >= 0; i--) {
    const d = new Date(now.getTime() - i * 86400000);
    days[d.toISOString().slice(0, 10)] = 0;
  }
  Object.entries(merged).forEach(([d, v]) => { if (days[d] !== undefined) days[d] = v.cost; });
  const maxCost = Math.max(...Object.values(days), 0.001);
  $('timeline').innerHTML = Object.entries(days).map(([d, v]) => {
    const h = Math.max(2, Math.round((v / maxCost) * 100));
    const cls = v === 0 ? 'zero' : d === today ? 'today' : '';
    return `<div class="tl-bar ${cls}" style="height:${h}%" title="${d}: ${money(v)}"></div>`;
  }).join('');
  $('tlLabels').innerHTML = Object.keys(days).map(d => `<span>${d.split('-')[2]}</span>`).join('');
  $('timelineBadge').textContent = `${Object.keys(days).length} days`;

  const modelAgg = {};
  Object.entries(cByModel).forEach(([m, s]) => { modelAgg[m] = { ...s }; });
  S.costs.forEach(c => {
    const m = c.model || 'unknown';
    if (!modelAgg[m]) modelAgg[m] = { calls: 0, tokens: 0, cost: 0 };
    modelAgg[m].calls++;
    modelAgg[m].tokens += c.tokens || 0;
    modelAgg[m].cost += c.cost || 0;
  });
  const models = Object.entries(modelAgg).sort((a, b) => b[1].cost - a[1].cost);
  $('byModelBadge').textContent = moneyShort(allTotal.cost);
  $('byModelTable').querySelector('tbody').innerHTML = models.length
    ? models.map(([m, s]) =>
        `<tr>
          <td class="mono">${esc(m.split('/').pop())}</td>
          <td class="mono" style="text-align:right">${s.calls}</td>
          <td class="mono" style="text-align:right">${bigNum(s.tokens)}</td>
          <td class="mono" style="text-align:right">${moneyShort(s.cost)}</td>
        </tr>`
      ).join('')
    : '<tr><td colspan="4" class="empty">No data</td></tr>';

  const roles = Object.entries(cByRole).sort((a, b) => b[1].cost - a[1].cost);
  $('byRoleBadge').textContent = roles.length;
  $('byRoleTable').querySelector('tbody').innerHTML = roles.length
    ? roles.map(([r, s]) =>
        `<tr>
          <td class="text">${esc(r)}</td>
          <td class="mono" style="text-align:right">${s.calls}</td>
          <td class="mono" style="text-align:right">${bigNum(s.tokens)}</td>
          <td class="mono" style="text-align:right">${moneyShort(s.cost)}</td>
        </tr>`
      ).join('')
    : '<tr><td colspan="4" class="empty">No data — run cost_aggregate.py</td></tr>';

  const recent = [...S.costs].sort((a, b) => (b.ts || 0) - (a.ts || 0)).slice(0, 100);
  $('recentCallsBadge').textContent = `${recent.length}`;
  $('recentCallsBody').innerHTML = recent.length
    ? recent.map(c => {
        const t = typeof c.ts === 'number' ? new Date(c.ts * 1000).toTimeString().slice(0, 8) : (c.ts || '').slice(11, 19);
        return `<tr>
          <td class="mono">${esc(t)}</td>
          <td class="mono">${esc(c.item || c.item_id || '—')}</td>
          <td class="text">${esc(c.role || '—')}</td>
          <td class="mono">${esc((c.model || '').split('/').pop())}</td>
          <td class="mono" style="text-align:right">${bigNum(c.tokens || 0)}</td>
          <td class="mono" style="text-align:right">${moneyShort(c.cost || 0)}</td>
        </tr>`;
      }).join('')
    : '<tr><td colspan="6" class="empty">No per-call records</td></tr>';
}

// ═══════════════════════════════════════════════════════════════
// PROVIDER
// ═══════════════════════════════════════════════════════════════
function renderProviderTab() {
  const data = (S.providerCosts && !Array.isArray(S.providerCosts)) ? S.providerCosts : {};
  const byModel = data.by_model || {};
  const byDay = data.by_day || {};
  const byRole = data.by_role || {};
  const totals = data.totals || {};
  const sources = data.sources || { historical: 0, live: 0, combined: 0 };

  const modelEntries = Object.entries(byModel);
  const dayEntries = Object.entries(byDay).sort();
  const roleEntries = Object.entries(byRole);
  const dayKeys = dayEntries.map(e => e[0]);

  $('pTotal').textContent = money(totals.cost || 0);
  $('pTotalSub').textContent = `${sources.historical || 0} hist · ${sources.live || 0} live`;
  $('pCalls').textContent = bigNum(totals.calls || 0);
  $('pCallsSub').textContent = `${modelEntries.length} models`;
  $('pRange').textContent = dayKeys.length ? `${dayKeys[0]} → ${dayKeys[dayKeys.length-1]}` : '—';
  $('pRangeSub').textContent = `${dayKeys.length} days`;
  $('pModels').textContent = modelEntries.length;
  $('pModelsSub').textContent = moneyShort(totals.cost || 0);
  $('pReasoningKpi').textContent = bigNum(totals.reasoning_tokens || 0);
  $('pReasoningSub').textContent = (totals.tokens || 0) > 0
    ? `${((totals.reasoning_tokens || 0) / totals.tokens * 100).toFixed(1)}% of tokens` : '—';

  $('pCostPrompt').textContent = moneyShort(totals.cost_prompt || 0);
  $('pCostCompletion').textContent = moneyShort(totals.cost_completion || 0);
  $('pReasoning').textContent = bigNum(totals.reasoning_tokens || 0);
  $('pCached').textContent = bigNum(totals.cached_tokens || 0);

  $('pByModelBadge').textContent = moneyShort(totals.cost || 0);
  document.querySelector('#pByModelTable tbody').innerHTML = modelEntries.map(([m, s]) =>
    `<tr><td class="mono">${esc(m)}</td>
      <td class="mono" style="text-align:right">${s.calls}</td>
      <td class="mono" style="text-align:right">${bigNum(s.tokens)}</td>
      <td class="mono" style="text-align:right;color:var(--accent)">${s.reasoning_tokens ? bigNum(s.reasoning_tokens) : '—'}</td>
      <td class="mono" style="text-align:right">${moneyShort(s.cost)}</td>
    </tr>`).join('') || '<tr><td colspan="5" class="empty">No data</td></tr>';

  $('pByDayBadge').textContent = `${dayKeys.length} days`;
  document.querySelector('#pByDayTable tbody').innerHTML = [...dayEntries].reverse().map(([d, s]) =>
    `<tr><td class="mono">${esc(d)}</td>
      <td class="mono" style="text-align:right">${s.calls}</td>
      <td class="mono" style="text-align:right">${bigNum(s.tokens)}</td>
      <td class="mono" style="text-align:right;color:var(--accent)">${s.reasoning_tokens ? bigNum(s.reasoning_tokens) : '—'}</td>
      <td class="mono" style="text-align:right">${moneyShort(s.cost)}</td>
    </tr>`).join('') || '<tr><td colspan="5" class="empty">No data</td></tr>';

  if ($('pByRoleTable')) {
    $('pByRoleBadge').textContent = roleEntries.length;
    document.querySelector('#pByRoleTable tbody').innerHTML = roleEntries.map(([r, s]) =>
      `<tr><td class="text">${esc(r)}</td>
        <td class="mono" style="text-align:right">${s.calls}</td>
        <td class="mono" style="text-align:right">${bigNum(s.tokens)}</td>
        <td class="mono" style="text-align:right;color:var(--accent)">${s.reasoning_tokens ? bigNum(s.reasoning_tokens) : '—'}</td>
        <td class="mono" style="text-align:right">${moneyShort(s.cost)}</td>
      </tr>`).join('') || '<tr><td colspan="5" class="empty">No data</td></tr>';
  }

  const maxCost = Math.max(...dayEntries.map(e => e[1].cost), 0.001);
  $('pTimeline').innerHTML = dayEntries.map(([d, s]) => {
    const h = Math.max(2, Math.round((s.cost / maxCost) * 100));
    const rs = s.reasoning_tokens ? ` · ${bigNum(s.reasoning_tokens)} reasoning` : '';
    return `<div class="tl-bar" style="height:${h}%" title="${d}: ${money(s.cost)}${rs}"></div>`;
  }).join('');
  $('pTimelineLabels').innerHTML = dayEntries.map(e => `<span>${e[0].slice(5)}</span>`).join('');
  $('pTimelineBadge').textContent = `${dayKeys.length} days · ${moneyShort(totals.cost || 0)}`;
  icons();
}

// ═══════════════════════════════════════════════════════════════
// LOGS (FIXED)
// ═══════════════════════════════════════════════════════════════
function renderLogsTab() {
  syncLogSourceChips();
  const q = S.logSearch.trim().toLowerCase();
  const lv = S.logLevel;
  const mod = S.logModule;

  // Parse all lines once
  const parsed = S.log.map(line => ({ line, ...parseLogLine(line) }));

  // Compute stats + module list from ALL lines
  const stats = { INFO: 0, WARNING: 0, ERROR: 0, DEBUG: 0, CRITICAL: 0 };
  const moduleSet = new Set();
  parsed.forEach(p => {
    if (p.isParsed) {
      if (stats[p.level] !== undefined) stats[p.level]++;
      if (p.module) moduleSet.add(p.module);
    }
  });
  const modules = [...moduleSet].sort();

  // Update stats bar
  $('logStats').innerHTML = `
    <div class="log-stat-item"><span>Total</span><span class="num">${S.log.length}</span></div>
    <div class="log-stat-item INFO"><span>INFO</span><span class="num">${stats.INFO}</span></div>
    <div class="log-stat-item WARNING"><span>WARN</span><span class="num">${stats.WARNING}</span></div>
    <div class="log-stat-item ERROR"><span>ERR</span><span class="num">${stats.ERROR}</span></div>
  `;
  const badgeCount = stats.ERROR > 0 ? stats.ERROR : (stats.WARNING > 0 ? stats.WARNING : S.log.length);
  $('tabLogsBadge').textContent = badgeCount;
  $('tabLogsBadge').className = 'tab-badge' + (stats.ERROR > 0 ? ' danger' : stats.WARNING > 0 ? ' warn' : '');

  // Update module chips
  const modChipsEl = $('logModuleChips');
  if (modChipsEl) {
    if (!modules.length) {
      modChipsEl.innerHTML = '';
    } else {
      modChipsEl.innerHTML = [
        `<button class="chip ${mod === 'all' ? 'active' : ''}" data-mod="all">All mods</button>`,
        ...modules.map(m => `<button class="chip ${mod === m ? 'active' : ''}" data-mod="${esc(m)}">${esc(m)}</button>`),
      ].join('');
    }
  }

  // Filter
  const filtered = parsed.filter(p => {
    if (lv !== 'all' && (!p.isParsed || p.level !== lv)) return false;
    if (mod !== 'all' && (!p.isParsed || p.module !== mod)) return false;
    if (q) {
      const hay = p.isParsed ? (p.message || '') : p.line;
      if (!hay.toLowerCase().includes(q)) return false;
    }
    return true;
  });

  const el = $('logFull');
  if (!filtered.length) {
    el.innerHTML = `<div class="empty" style="padding:20px">No matching lines${S.log.length ? ` (${S.log.length} total, filtered)` : ''}</div>`;
    updateScrollBtn();
    return;
  }

  // Search highlight helper
  const hl = (text) => {
    const escText = esc(text);
    if (!q) return escText;
    const re = new RegExp('(' + q.replace(/[.*+?^${}()|[\]\\]/g, '\\$&') + ')', 'gi');
    return escText.replace(re, '<mark style="background:var(--warn-soft);color:var(--warn);padding:0 2px;border-radius:2px">$1</mark>');
  };

  // Cap render to avoid freezing browser with 10k lines
  const MAX = 3000;
  const overflow = filtered.length > MAX;
  const visible = overflow ? filtered.slice(-MAX) : filtered;

  const html = (overflow
    ? `<div style="padding:6px 10px;font-family:'JetBrains Mono',monospace;font-size:10px;color:var(--text-3);background:var(--surface-2);border-radius:3px;margin-bottom:6px">Showing last ${MAX} of ${filtered.length} matching lines</div>`
    : '') +
    visible.map((p, idx) => {
      if (!p.isParsed) {
        return `<div class="log-row" data-line-idx="${idx}">
          <span class="log-m">${hl(p.line)}</span>
          <button class="log-copy" onclick="copyLogLine(${idx})" title="Copy"><i data-lucide="copy"></i></button>
        </div>`;
      }
      return `<div class="log-row" data-line-idx="${idx}">
        <span class="log-t">${p.time}</span>
        ${p.module ? `<span class="log-mod">${esc(p.module)}</span>` : ''}
        <span class="log-lv ${p.level}">${p.level}</span>
        <span class="log-m">${hl(p.message)}</span>
        <button class="log-copy" onclick="copyLogLine(${idx})" title="Copy"><i data-lucide="copy"></i></button>
      </div>`;
    }).join('');

  const wasAtBottom = el.scrollHeight - el.scrollTop - el.clientHeight < 80;
  el.innerHTML = html;

  // Cache filtered for copy handler
  window._logFilteredCache = visible;

  if (S.logFollow && wasAtBottom) el.scrollTop = el.scrollHeight;
  icons();
  updateScrollBtn();
}

function copyLogLine(idx) {
  const cached = window._logFilteredCache;
  if (!cached || !cached[idx]) return;
  const p = cached[idx];
  const text = p.isParsed
    ? `${p.date} ${p.time}${p.module ? ' [' + p.module + ']' : ''} ${p.level} ${p.message}`
    : p.line;
  navigator.clipboard?.writeText(text).then(
    () => toast('Copied', 'Log line to clipboard', false, 1500),
    () => toast('Copy failed', 'Clipboard unavailable', true),
  );
}

function updateScrollBtn() {
  const el = $('logFull');
  const btn = $('logScrollBtn');
  if (!el || !btn) return;
  const atBottom = el.scrollHeight - el.scrollTop - el.clientHeight < 40;
  btn.classList.toggle('hide', atBottom);
}

function scrollToBottomLog() {
  const el = $('logFull');
  if (el) el.scrollTop = el.scrollHeight;
  updateScrollBtn();
}

// ═══════════════════════════════════════════════════════════════
// ACTIVITY (overview mini log)
// ═══════════════════════════════════════════════════════════════
function renderActivity() {
  const recent = S.log.slice(-30).reverse();
  if (!recent.length) {
    $('activityLog').innerHTML = '<div class="empty" style="padding:20px 0;font-size:11px">Waiting for log…</div>';
    return;
  }
  $('activityBadge').textContent = `${recent.length} entries`;
  $('activityUpdated').textContent = S.lastFetch.log ? fmtTs(S.lastFetch.log) : '';
  $('activityLog').innerHTML = recent.map(line => {
    const p = parseLogLine(line);
    if (!p.isParsed) return `<div class="act-row"><span class="act-msg">${esc(line)}</span></div>`;
    return `<div class="act-row">
      <span class="act-time">${p.time}</span>
      ${p.module ? `<span class="act-mod">${esc(p.module)}</span>` : ''}
      <span class="act-lv ${p.level}">${p.level}</span>
      <span class="act-msg">${esc(p.message)}</span>
    </div>`;
  }).join('');
}

