function renderToolHistory() {
  const container = $('toolResults');
  if (!container) return;
  if (!S.toolHistory.length) { container.innerHTML = ''; return; }
  container.innerHTML = S.toolHistory.slice(0, 10).map((r, idx) => {
    const ok = r.data.status === 'completed';
    const output = r.data.stdout || r.data.stderr || r.data.error || '(no output)';
    const { html, isStructured } = renderToolOutput(r.name, output);
    return `<div class="tool-result" data-idx="${idx}">
      <div class="tool-result-h">
        <i data-lucide="${ok ? 'check-circle-2' : 'alert-circle'}"></i>
        <span class="${ok ? 'status-ok' : 'status-err'}"><strong>${esc(r.name)}</strong> — ${esc(r.data.status || 'unknown')}</span>
        <span class="meta">${fmtTs(r.at)}</span>
        <button class="close-r" onclick="removeToolHistory(${idx})"><i data-lucide="x"></i></button>
      </div>
      <div class="tool-result-b ${isStructured ? 'structured' : ''}">${html}</div>
    </div>`;
  }).join('');
  icons();
}

function removeToolHistory(idx) {
  S.toolHistory.splice(idx, 1);
  renderToolHistory();
}

// Render tool output — try to structure known formats
function renderToolOutput(name, output) {
  // JSON?
  const trimmed = (output || '').trim();
  if (trimmed.startsWith('{') || trimmed.startsWith('[')) {
    try {
      const parsed = JSON.parse(trimmed);
      return { html: `<pre style="margin:0">${esc(JSON.stringify(parsed, null, 2))}</pre>`, isStructured: true };
    } catch (e) { /* not JSON */ }
  }

  // Chunker stats — parse into sections
  if (/PHASE 1: EXTRACTED|VERDICT BREAKDOWN/.test(output)) {
    const html = output.split('\n').map(line => {
      if (/^═+$/.test(line.trim()) || /^─+$/.test(line.trim())) {
        return `<div style="height:1px;background:var(--border);margin:6px 0"></div>`;
      }
      if (/PHASE \d|VERDICT|LEVEL BREAKDOWN|TOTAL:|Cost:/.test(line)) {
        return `<div style="color:var(--accent);font-weight:600;margin-top:4px">${esc(line)}</div>`;
      }
      const m = line.match(/^\s+(\S+)\s+(\d+)\s+problems/);
      if (m) {
        return `<div style="display:flex;justify-content:space-between;padding:1px 0">
          <span style="color:var(--text-2)">${esc(m[1])}</span>
          <span style="color:var(--accent)">${m[2]}</span>
        </div>`;
      }
      return `<div>${esc(line)}</div>`;
    }).join('');
    return { html, isStructured: true };
  }

  return { html: esc(output), isStructured: false };
}

