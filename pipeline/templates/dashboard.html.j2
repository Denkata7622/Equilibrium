async function autoRunChunkerStats() {
  try {
    const r = await fetch('/api/tools/chunker-stats', { method: 'POST' });
    if (!r.ok) { renderExtractionTab(); return; }
    const d = await r.json();
    const stdout = String(d.stdout || d.output || d.result || d.data || '');
    const stderr = String(d.stderr || '');
    // Parse from either — status may be "failed" just because fitz warned
    const parsed = parseChunkerStats(stdout) || parseChunkerStats(stderr);
    if (parsed) {
      S.chunkerStats = parsed;
      S.chunkerStatsAt = Date.now();
      persistChunker();
    }
    renderExtractionTab();
  } catch (e) {
    renderExtractionTab();
  }
}

async function runChunkerStats(btn) {
  await withLoading(btn, 'Loading', async () => {
    try {
      const r = await fetch('/api/tools/chunker-stats', { method: 'POST' });
      if (!r.ok) throw new Error(`HTTP ${r.status}`);
      const d = await r.json();

      // Server may use different field names — extract from any of them
      const stdout = String(d.stdout || d.output || d.result || d.data || '');
      const stderr = String(d.stderr || '');

      // Log for debugging
      pushExtractionHistory('chunker-stats', { ...d, stdout, stderr });

      // ALWAYS try to parse — the server may mark the call as failed
      // just because Python printed a FutureWarning to stderr, while
      // stdout still contains valid stats.
      const parsed = parseChunkerStats(stdout) || parseChunkerStats(stderr);

      if (parsed) {
        S.chunkerStats = parsed;
        S.chunkerStatsAt = Date.now();
        persistChunker();
        const msg = `${parsed.extracted.pdfs} PDFs · ${parsed.realProblems.total} real problems`;
        toast('Stats loaded', msg);
        renderExtractionTab();
        return;
      }

      // Parse failed — show REAL error, not the fitz warning
      const cleanErr = stripPythonWarnings(stderr || stdout);
      console.warn('[chunker-stats] parse failed', {
        status: d.status, returncode: d.returncode,
        stdoutLen: stdout.length, stderrLen: stderr.length,
      });
      const fallback = cleanErr.slice(0, 300) || 'No parsable output from chunker-stats';
      toast('Stats failed', fallback, true);
      renderExtractionTab();
    } catch (e) {
      pushExtractionHistory('chunker-stats', { status: 'error', error: e.message });
      toast('Stats error', e.message, true);
    }
  });
}

async function runChunkerAudit(btn) {
  await withLoading(btn, 'Auditing', async () => {
    try {
      const r = await fetch('/api/tools/chunker-audit', { method: 'POST' });
