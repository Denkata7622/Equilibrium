  if (!_logSourceChipsEl) return;
  _logSourceChipsEl.querySelectorAll('.chip').forEach(c => {
    c.classList.toggle('active', c.dataset.source === S.logSource);
  });
}

$('auditSearch').addEventListener('input', debounce(e => { S.auditSearch = e.target.value; renderAuditVisual(); }, 150));
$('auditChips').addEventListener('click', e => {
  const chip = e.target.closest('.chip');
  if (!chip) return;
  document.querySelectorAll('#auditChips .chip').forEach(c => c.classList.remove('active'));
  chip.classList.add('active');
  S.auditFilter = chip.dataset.audit;
  renderAuditVisual();
});

// Apply saved filters
if (S.artVerdict !== 'all') {
  const chip = document.querySelector(`#artChips .chip[data-verdict="${S.artVerdict}"]`);
  if (chip) {
    document.querySelectorAll('#artChips .chip').forEach(c => c.classList.remove('active'));
    chip.classList.add('active');
  }
}
if (S.logLevel !== 'all') {
  const chip = document.querySelector(`#logChips .chip[data-lv="${S.logLevel}"]`);
  if (chip) {
    document.querySelectorAll('#logChips .chip').forEach(c => c.classList.remove('active'));
    chip.classList.add('active');
  }
}
$('logFollow').checked = S.logFollow;

// ═══════════════════════════════════════════════════════════════
// POLLING
// ═══════════════════════════════════════════════════════════════
async function refreshLoop() {
  await Promise.all([
    fetchState(), fetchQueue(), fetchCostsAll(), fetchOrch(), fetchArticles(), fetchProviderCosts(true),
  ]);
  const activeTab = document.querySelector('.tab.active')?.dataset.tab;
  if (activeTab === 'overview') renderOverview();
  if (activeTab === 'extraction') renderExtractionTab();
  if (activeTab === 'articles') renderArticlesTab();
  if (activeTab === 'costs') renderCostsTab();
  if (activeTab === 'provider') renderProviderTab();
}

async function logLoop() {
  const prevLogLen = S.log.length;
  const prevSource = S.logSourceActive || S.logSource;
  await fetchLog();
  const sourceChanged = prevSource !== S.logSourceActive;
  renderActivity();

  const activeTab = document.querySelector('.tab.active')?.dataset.tab;
  if (activeTab === 'logs') {
    // Skip re-render if log unchanged (avoids losing scroll position)
    if (S.log.length !== prevLogLen || sourceChanged) renderLogsTab();
  }
  if (activeTab === 'overview') renderExtractionPulse();
  if (activeTab === 'extraction' && S.chunkerProgress?.isRunning) renderExtractionTab();
}

setInterval(() => {
  if (S.running && S.uptimeBase) {
    $('mUptime').textContent = uptime(Math.floor((Date.now() - S.uptimeBase) / 1000));
  }
}, 1000);

async function pollRefresher() {
  try { await refreshLoop(); } catch (e) {}
  setTimeout(pollRefresher, document.hidden ? 15000 : 5000);
}
async function pollLogger() {
  try { await logLoop(); } catch (e) {}
  setTimeout(pollLogger, document.hidden ? 10000 : 3000);
}

// ═══════════════════════════════════════════════════════════════
// BOOT
// ═══════════════════════════════════════════════════════════════
function boot() {
  if (!window.lucide) { setTimeout(boot, 100); return; }
  icons();
  loadPersistedChunker();
  syncLogSourceChips();
  refreshLoop();
  logLoop();
  pollRefresher();
  pollLogger();
}
document.addEventListener('DOMContentLoaded', boot);
</script>

</body>
</html>