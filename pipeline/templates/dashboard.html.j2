<script>
// ═══════════════════════════════════════════════════════════════
// HELPERS
// ═══════════════════════════════════════════════════════════════
const $ = id => document.getElementById(id);

let _iconsScheduled = false;
function icons() {
  if (_iconsScheduled) return;
  _iconsScheduled = true;
  queueMicrotask(() => {
    _iconsScheduled = false;
    if (window.lucide?.createIcons) {
      try { window.lucide.createIcons(); } catch (e) {}
    }
  });
}

function esc(s) {
  return String(s ?? '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
}
function money(n) { return '$' + (Number(n) || 0).toFixed(4); }
function moneyShort(n) {
  n = Number(n) || 0;
  if (n === 0) return '$0';
  if (n < 0.01) return '<$0.01';
  if (n < 1) return '$' + n.toFixed(3);
  return '$' + n.toFixed(2);
}
function bigNum(n) {
  n = Number(n) || 0;
  if (n >= 1e6) return (n/1e6).toFixed(2) + 'M';
  if (n >= 1e3) return (n/1e3).toFixed(1) + 'K';
  return String(n);
}
function uptime(s) {
  const h = Math.floor(s/3600), m = Math.floor((s%3600)/60), sec = s%60;
  if (h) return `${h}h ${m}m`;
  if (m) return `${m}m ${sec}s`;
  return `${sec}s`;
}
function timeAgo(ts) {
  if (!ts) return '—';
  const d = Date.now() - ts * 1000;
  if (d < 60000) return Math.floor(d/1000) + 's';
  if (d < 3600000) return Math.floor(d/60000) + 'm';
  if (d < 86400000) return Math.floor(d/3600000) + 'h';
  return Math.floor(d/86400000) + 'd';
}
function tsDay(ts) {
  if (!ts) return '';
  if (typeof ts === 'string') {
    if (/^\d{4}-\d{2}-\d{2}/.test(ts)) return ts.slice(0, 10);
    const n = Number(ts);
    if (!isNaN(n)) ts = n;
    else return '';
  }
  if (typeof ts === 'number') {
    const ms = ts < 1e11 ? ts * 1000 : ts;
    try { return new Date(ms).toISOString().slice(0, 10); } catch (e) { return ''; }
  }
  return '';
}
function fmtTs(ts) {
  if (!ts) return '';
  const d = new Date(ts);
  return d.toLocaleTimeString('bg-BG', { hour: '2-digit', minute: '2-digit' }) + ':' + String(d.getSeconds()).padStart(2, '0');
}
function debounce(fn, ms = 150) {
  let t;
  return (...args) => { clearTimeout(t); t = setTimeout(() => fn(...args), ms); };
}

// ═══════════════════════════════════════════════════════════════
// STRIP PYTHON WARNINGS
// Removes FutureWarning/DeprecationWarning lines that Python prints
// to stderr before the actual tool output. Without this, stats/audit
// parsing sees garbage and fails.
// ═══════════════════════════════════════════════════════════════
function stripPythonWarnings(text) {
  if (!text) return '';
  return text.split('\n')
    .filter(line => {
      if (/\.py:\d+:\s*\w*Warning:/.test(line)) return false;
      if (/^\s+warnings\.warn\(/.test(line)) return false;
      if (/^[A-Z]:\\.*\.py:\d+:\s*$/.test(line.trim())) return false;
      return true;
    })
    .join('\n')
    .trim();
}

// ═══════════════════════════════════════════════════════════════
// CRITICAL: LOG LINE PARSER (fixed)
// Supports:
//   2026-11-10 10:02:40,908 [PDF_CHUNKER] INFO [context] message
//   2026-11-10 10:02:40,908 [INFO] message
//   2026-11-10 10:02:40,908 INFO message
// ═══════════════════════════════════════════════════════════════
const LOG_RE = /^(\d{4}-\d{2}-\d{2})\s+(\d{2}:\d{2}:\d{2}),\d+\s+(?:\[([A-Za-z_][\w.]*)\]\s+)?(INFO|WARNING|ERROR|DEBUG|CRITICAL)\s+([\s\S]*)$/;

function parseLogLine(line) {
  const m = line.match(LOG_RE);
  if (!m) return { raw: line, isParsed: false };
  return {
    isParsed: true,
    date: m[1], time: m[2],
    module: m[3] || null,
    level: m[4],
    message: m[5],
  };
}

function getLogLevel(line) {
  const p = parseLogLine(line);
  return p.isParsed ? p.level : null;
}

// ═══════════════════════════════════════════════════════════════
// CRITICAL: CHUNKER STATS PARSER
// Parses output of `python pdf_chunker.py --stats`
// ═══════════════════════════════════════════════════════════════
function parseChunkerStats(rawText) {
  if (!rawText) return null;
  const text = stripPythonWarnings(rawText);
  if (!text) return null;
  const result = {
    extracted: { pdfs: 0, problems: 0, partial: 0 },
    merged: { olympiads: 0, problems: 0 },
    classified: { olympiads: 0, problems: 0, off: 0 },
    realProblems: { total: 0, points: 0, byPoint: {} },
    cost: 0,
    verdicts: {},
    levels: {},
    needsReview: 0,
    hasAny: false,
  };

  let m;

  // PHASE 1
  m = text.match(/PDFs:\s*(\d+)\s*\|\s*problems:\s*(\d+)\s*\|\s*partial:\s*(\d+)/);
  if (m) {
    result.extracted.pdfs = +m[1];
    result.extracted.problems = +m[2];
    result.extracted.partial = +m[3];
    result.hasAny = true;
  }

  // PHASE 2 — careful: it matches "Olympiads: N | problems: M"
  m = text.match(/Olympiads:\s*(\d+)\s*\|\s*problems:\s*(\d+)/);
  if (m) {
    result.merged.olympiads = +m[1];
    result.merged.problems = +m[2];
  }

  // PHASE 3 — careful: same "Olympiads: N | problems: M | off: K"
  m = text.match(/Olympiads:\s*(\d+)\s*\|\s*problems:\s*(\d+)\s*\|\s*off:\s*(\d+)/);
  if (m) {
    result.classified.olympiads = +m[1];
    result.classified.problems = +m[2];
    result.classified.off = +m[3];
  }

  // TOTAL
  m = text.match(/TOTAL:\s*(\d+)\s+real problems across\s+(\d+)\s+points/);
  if (m) {
    result.realProblems.total = +m[1];
    result.realProblems.points = +m[2];
  }

  // Cost
  m = text.match(/Cost:\s*\$([\d.]+)/);
  if (m) result.cost = parseFloat(m[1]);

  // VERDICT BREAKDOWN
  const vMatch = text.match(/VERDICT BREAKDOWN([\s\S]*?)(?:LEVEL BREAKDOWN|$)/);
  if (vMatch) {
    for (const line of vMatch[1].split('\n')) {
      const mm = line.match(/^\s+([A-Za-z_]+):\s+(\d+)/);
      if (mm) result.verdicts[mm[1]] = +mm[2];
    }
  }

  // LEVEL BREAKDOWN
  const lMatch = text.match(/LEVEL BREAKDOWN([\s\S]*?)$/);
  if (lMatch) {
    for (const line of lMatch[1].split('\n')) {
      const mm = line.match(/^\s+(L\d_\w+|exhausted|unknown):\s+(\d+)/);
      if (mm) result.levels[mm[1]] = +mm[2];
      const nr = line.match(/needs_review:\s*(\d+)/);
      if (nr) result.needsReview = +nr[1];
    }
  }

  // Real problems per point — parse the "PHASE 4" table
  const p4Match = text.match(/PHASE 4: REAL_PROBLEMS[\s\S]*?(?=\n\s*TOTAL:|$)/);
  if (p4Match) {
    for (const line of p4Match[0].split('\n')) {
      const mm = line.match(/^\s+(R?\.?[\d.]+)\s+(\d+)\s+problems\s+\(easy=\s*(\d+),\s*medium=\s*(\d+),\s*hard=\s*(\d+)\)/);
      if (mm) {
        result.realProblems.byPoint[mm[1]] = {
          total: +mm[2], easy: +mm[3], medium: +mm[4], hard: +mm[5]
        };
      }
    }
  }

  return result.hasAny ? result : null;
}

// ═══════════════════════════════════════════════════════════════
// CRITICAL: PDF AUDIT PARSER
// Parses output of `python pdf_chunker.py --audit`
// ═══════════════════════════════════════════════════════════════
function parseAuditText(text) {
  if (!text) return [];
  const lines = text.split('\n');
  const rows = [];
  let inTable = false;

  for (const line of lines) {
    if (/EXTRACTION AUDIT/.test(line)) { inTable = true; continue; }
    if (!inTable) continue;
    if (/^\s*$/.test(line)) continue;
    if (/^─+/.test(line) || /^═+/.test(line)) continue;
    if (/PDF\s+Pg\s+C\/P/.test(line)) continue;
    if (/^\s+OK:\s+\d+/.test(line)) continue;
    if (/^\s+⚠/.test(line) || /^\s+❌/.test(line)) continue;
    if (/Unprocessed PDFs/.test(line)) continue;
    if (/^\s+💡/.test(line) || /^\s+\.\\py/.test(line)) break;

    // Data row: PDF (may be truncated), pages, chars/page, problems, P/Pg, Status, State
    // PDF field may contain spaces; the numeric columns are right-aligned
    const m = line.match(/^\s{2}(.{3,60}?)\s+(\d+)\s+(\d+)\s+(\d+)\s+([\d.]+)\s+(OK|⚠ LOW|❌ EMPTY|⚠ NO_TEXT|△ OCR\?)\s+(\S+)\s*$/);
    if (m) {
      rows.push({
        pdf: m[1].trim(),
        pages: +m[2],
        charsPerPage: +m[3],
        problems: +m[4],
        problemsPerPage: parseFloat(m[5]),
        status: m[6],
        state: m[7],
      });
      continue;
    }

    // Fallback looser regex if strict fails
    const ml = line.match(/^\s{2}(.+?)\s{2,}(\d+)\s+(\d+)\s+(\d+)\s+([\d.]+)\s+(.+?)\s+(\S+)\s*$/);
    if (ml) {
      rows.push({
        pdf: ml[1].trim(),
        pages: +ml[2],
        charsPerPage: +ml[3],
        problems: +ml[4],
        problemsPerPage: parseFloat(ml[5]),
        status: ml[6].trim(),
        state: ml[7],
      });
    }
  }
  return rows;
}

function groupPdfByOlympiad(pdfName) {
  // Extract olympiad prefix from filename
  // OLI-2-Областен кръг-2024-11 кл-probs → "OLI-2 ОБЛАСТЕН 2024"
  // OLI-3-Национален кръг-1983-9-12 кл-probs → "OLI-3 НАЦИОНАЛЕН 1983"
  // BMO_1984-2006 → "BMO 1984-2006"
  // NOM_2015 → "NOM 2015"
  let m = pdfName.match(/^(OLI-\d+)-(.+?)-(\d{4})/);
  if (m) {
    const round = m[2].includes('Областен') ? 'ОБЛАСТЕН' : m[2].includes('Национален') ? 'НАЦИОНАЛЕН' : m[2];
    return `${m[1]} ${round} ${m[3]}`;
  }
  m = pdfName.match(/^([A-Z]+)_?(\d{4}(?:-\d{4})?)/);
  if (m) return `${m[1]} ${m[2]}`;
  const first = pdfName.split(/[_\-\s]/)[0];
  return first || 'other';
}

// ═══════════════════════════════════════════════════════════════
// TOAST
// ═══════════════════════════════════════════════════════════════
let _toastTimer = null;
function toast(title, text = '', isError = false, duration = 5000) {
  const el = $('toast');
  $('toastTitle').textContent = title;
  $('toastText').textContent = text || '';
  el.classList.toggle('error', isError);
  el.querySelector('svg')?.remove();
  const icon = document.createElement('i');
  icon.setAttribute('data-lucide', isError ? 'alert-circle' : 'check-circle-2');
  el.insertBefore(icon, el.firstChild);
  icons();
  el.classList.add('show');
  clearTimeout(_toastTimer);
  _toastTimer = setTimeout(() => el.classList.remove('show'), duration);
}

async function withLoading(el, label, fn) {
  const btn = el?.closest?.('.btn') || el?.closest?.('.action-tile') || (el?.tagName === 'BUTTON' ? el : null);
  if (!btn) { await fn(); return; }
  const orig = btn.innerHTML;
  btn.classList.add('loading');
  btn.disabled = true;
  btn.innerHTML = `<i data-lucide="loader-2"></i> ${label}`;
  icons();
  try { await fn(); }
  finally {
    btn.classList.remove('loading');
    btn.disabled = false;
    btn.innerHTML = orig;
    icons();
  }
}

