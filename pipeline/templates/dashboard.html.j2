      const d = await r.json();

      const stdout = String(d.stdout || d.output || d.result || d.data || '');
      const stderr = String(d.stderr || '');

      pushExtractionHistory('chunker-audit', { ...d, stdout, stderr });

      const rows = parseAuditText(stdout) || parseAuditText(stderr);

