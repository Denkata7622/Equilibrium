<!DOCTYPE html>
<html lang="bg">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Pipeline · Control Center</title>
<link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%2322c55e' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%3E%3Cpath d='M22 12h-4l-3 9L9 3l-3 9H2'/%3E%3C/svg%3E">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/lucide@0.454.0/dist/umd/lucide.min.js" defer></script>
<style>
:root {
  --bg: #0a0b0e; --surface: #0f1115; --surface-2: #14171d; --surface-3: #1a1e26;
  --border: #1c2029; --border-2: #262b36; --border-3: #343a48;
  --text: #e8eaed; --text-2: #a8adb8; --text-3: #6e7480; --text-4: #4a505c;
  --accent: #22c55e; --accent-soft: rgba(34,197,94,0.10); --accent-line: rgba(34,197,94,0.28);
  --danger: #ef4444; --danger-soft: rgba(239,68,68,0.10); --danger-line: rgba(239,68,68,0.28);
  --warn: #f59e0b; --warn-soft: rgba(245,158,11,0.10); --warn-line: rgba(245,158,11,0.28);
  --info: #3b82f6; --info-soft: rgba(59,130,246,0.10); --info-line: rgba(59,130,246,0.28);
  --purple: #a855f7; --purple-soft: rgba(168,85,247,0.10); --purple-line: rgba(168,85,247,0.28);
}
* { margin: 0; padding: 0; box-sizing: border-box; }
html { color-scheme: dark; }
body {
  background: var(--bg); color: var(--text);
  font-family: 'Inter', -apple-system, sans-serif;
  font-size: 13px; line-height: 1.45; -webkit-font-smoothing: antialiased;
  min-height: 100vh;
}
button, input, select, textarea { font-family: inherit; }
button { cursor: pointer; }
a { color: inherit; text-decoration: none; }
.mono { font-family: 'JetBrains Mono', monospace; }
.grow { flex: 1; min-width: 0; }
.hide { display: none !important; }
.spin { animation: spin 1s linear infinite; }
@keyframes spin { to { transform: rotate(360deg); } }
@keyframes pulse { 0%,100%{opacity:1} 50%{opacity:0.4} }
@keyframes shimmer { 0%{opacity:.6} 50%{opacity:1} 100%{opacity:.6} }

/* HEADER */
.hdr {
  height: 52px; padding: 0 20px; background: var(--surface);
  border-bottom: 1px solid var(--border);
  display: flex; align-items: center; gap: 20px;
  position: sticky; top: 0; z-index: 40;
}
.hdr-brand { display: flex; align-items: center; gap: 8px; font-weight: 600; font-size: 13px; flex-shrink: 0; }
.hdr-brand svg { width: 16px; height: 16px; color: var(--accent); stroke-width: 2.5; }
.tabs { display: flex; gap: 2px; flex: 1; overflow-x: auto; scrollbar-width: none; }
.tabs::-webkit-scrollbar { display: none; }
.tab {
  display: flex; align-items: center; gap: 6px;
  padding: 8px 14px; background: transparent; border: none; border-radius: 5px;
  font-size: 12px; font-weight: 500; color: var(--text-3);
  white-space: nowrap; transition: all 0.12s; position: relative;
}
.tab:hover { color: var(--text-2); background: var(--surface-2); }
.tab.active { color: var(--text); background: var(--surface-2); }
.tab.active::after {
  content: ''; position: absolute; bottom: -1px; left: 12px; right: 12px;
  height: 2px; background: var(--accent); border-radius: 2px;
}
.tab svg { width: 13px; height: 13px; opacity: 0.7; }
.tab.active svg { opacity: 1; color: var(--accent); }
.tab-badge {
  font-size: 10px; font-weight: 600; padding: 1px 5px;
  background: var(--surface-3); color: var(--text-3); border-radius: 3px;
  font-family: 'JetBrains Mono', monospace; margin-left: 2px;
}
.tab-badge.warn { background: var(--warn-soft); color: var(--warn); }
.tab-badge.accent { background: var(--accent-soft); color: var(--accent); }
.hdr-right { display: flex; align-items: center; gap: 12px; flex-shrink: 0; }
.status {
  display: inline-flex; align-items: center; gap: 6px;
  padding: 4px 9px; background: var(--surface-2); border: 1px solid var(--border-2);
  border-radius: 5px; font-size: 11px; font-weight: 500; color: var(--text-2);
}
.status .dot { width: 6px; height: 6px; border-radius: 50%; background: var(--text-4); }
.status.running { color: var(--accent); border-color: var(--accent-line); background: var(--accent-soft); }
.status.running .dot { background: var(--accent); box-shadow: 0 0 6px rgba(34,197,94,0.5); animation: pulse 2s ease-in-out infinite; }
.status.error { color: var(--danger); border-color: var(--danger-line); background: var(--danger-soft); }
.status.error .dot { background: var(--danger); }
.hdr-link {
  color: var(--text-3); font-size: 11.5px; padding: 5px 10px; border-radius: 4px;
  display: inline-flex; align-items: center; gap: 5px; transition: all 0.12s;
}
.hdr-link:hover { color: var(--text); background: var(--surface-2); }
.hdr-link svg { width: 12px; height: 12px; }

/* MAIN */
.main { max-width: 1700px; margin: 0 auto; padding: 16px 20px 60px; }
.tab-panel { display: none; }
.tab-panel.active { display: block; }

/* KPI */
.kpis { display: grid; grid-template-columns: repeat(5, 1fr); gap: 10px; margin-bottom: 12px; }
.kpis.k4 { grid-template-columns: repeat(4, 1fr); }
.kpis.k3 { grid-template-columns: repeat(3, 1fr); }
.kpi {
  background: var(--surface); border: 1px solid var(--border);
  border-radius: 6px; padding: 12px 14px;
}
.kpi-h {
  display: flex; align-items: center; gap: 5px;
  font-size: 10px; font-weight: 600; text-transform: uppercase;
  letter-spacing: 0.7px; color: var(--text-3); margin-bottom: 6px;
}
.kpi-h svg { width: 11px; height: 11px; stroke-width: 2.5; }
.kpi-v {
  font-family: 'JetBrains Mono', monospace;
  font-size: 22px; font-weight: 500; line-height: 1.1; color: var(--text);
}
.kpi-v.accent { color: var(--accent); }
.kpi-v.warn { color: var(--warn); }
.kpi-v.danger { color: var(--danger); }
.kpi-v.info { color: var(--info); }
.kpi-v.purple { color: var(--purple); }
.kpi-s { font-family: 'JetBrains Mono', monospace; font-size: 10.5px; color: var(--text-3); margin-top: 3px; }
.kpi.skeleton .kpi-v, .kpi.skeleton .kpi-s {
  color: transparent; background: var(--surface-2); border-radius: 3px;
  animation: shimmer 1.4s infinite;
}

/* CARD */
.card {
  background: var(--surface); border: 1px solid var(--border);
  border-radius: 6px; overflow: hidden; display: flex; flex-direction: column; min-height: 0;
}
.card-h {
  display: flex; align-items: center; gap: 8px;
  padding: 10px 14px; border-bottom: 1px solid var(--border);
  min-height: 42px; flex-shrink: 0;
}
.card-h > svg { width: 13px; height: 13px; color: var(--text-3); }
.card-title {
  font-size: 11px; font-weight: 600; text-transform: uppercase;
  letter-spacing: 0.7px; color: var(--text-2);
}
.card-badge {
  margin-left: auto; font-family: 'JetBrains Mono', monospace;
  font-size: 10.5px; color: var(--text-3); padding: 2px 7px;
  background: var(--surface-2); border-radius: 4px; font-weight: 500;
}
.card-badge.accent { color: var(--accent); background: var(--accent-soft); }
.card-badge.warn { color: var(--warn); background: var(--warn-soft); }
.card-badge.danger { color: var(--danger); background: var(--danger-soft); }
.card-badge.info { color: var(--info); background: var(--info-soft); }
.card-body { padding: 12px 14px; flex: 1; min-height: 0; overflow: auto; }
.card-body.flush { padding: 0; }
.updated { font-family: 'JetBrains Mono', monospace; font-size: 9.5px; color: var(--text-4); margin-left: 6px; }

/* BUTTON */
.btn {
  display: inline-flex; align-items: center; justify-content: center; gap: 6px;
  height: 30px; padding: 0 11px; font-size: 11.5px; font-weight: 500;
  color: var(--text-2); background: var(--surface-2); border: 1px solid var(--border-2);
  border-radius: 5px; transition: all 0.12s; white-space: nowrap;
}
.btn > svg { width: 12px; height: 12px; flex-shrink: 0; }
.btn:hover:not(:disabled) { background: var(--surface-3); color: var(--text); border-color: var(--border-3); }
.btn:active:not(:disabled) { transform: translateY(1px); }
.btn:disabled { opacity: 0.4; cursor: not-allowed; }
.btn.primary { color: var(--accent); border-color: var(--accent-line); background: var(--accent-soft); }
.btn.primary:hover:not(:disabled) { background: var(--accent); color: #052e16; }
.btn.danger { color: var(--danger); border-color: var(--danger-line); background: var(--danger-soft); }
.btn.danger:hover:not(:disabled) { background: var(--danger); color: #fff; }
.btn.warn { color: var(--warn); border-color: var(--warn-line); background: var(--warn-soft); }
.btn.warn:hover:not(:disabled) { background: var(--warn); color: #1a1206; }
.btn.purple { color: var(--purple); border-color: var(--purple-line); background: var(--purple-soft); }
.btn.purple:hover:not(:disabled) { background: var(--purple); color: #fff; }
.btn.info { color: var(--info); border-color: var(--info-line); background: var(--info-soft); }
.btn.info:hover:not(:disabled) { background: var(--info); color: #fff; }
.btn.icon { padding: 0; width: 30px; }
.btn.sm { height: 26px; padding: 0 9px; font-size: 11px; }
.btn.xs { height: 22px; padding: 0 7px; font-size: 10.5px; }
.btn.loading { pointer-events: none; opacity: 0.6; }
.btn.loading > svg { animation: spin 0.8s linear infinite; }

/* INPUT */
.input {
  height: 30px; padding: 0 10px; font-size: 11.5px; color: var(--text);
  background: var(--surface-2); border: 1px solid var(--border-2);
  border-radius: 5px; outline: none; transition: border-color 0.12s; width: 100%;
}
.input.mono { font-family: 'JetBrains Mono', monospace; }
.input:focus { border-color: var(--accent-line); }
.input::placeholder { color: var(--text-4); }
.checkbox-label {
  display: flex; align-items: center; gap: 6px;
  font-size: 11px; color: var(--text-3); cursor: pointer; user-select: none;
}
.checkbox-label input { accent-color: var(--accent); }

/* LAYOUT */
.grid { display: grid; gap: 12px; }
.g2 { grid-template-columns: 1fr 1fr; }
.g3 { grid-template-columns: repeat(3, 1fr); }
.g1-2 { grid-template-columns: 1fr 2fr; }
.g2-1 { grid-template-columns: 2fr 1fr; }
.mb12 { margin-bottom: 12px; }

/* ACTION BAR */
.action-bar {
  display: flex; align-items: center; gap: 6px; flex-wrap: wrap;
  margin-bottom: 12px; padding: 8px 10px;
  background: var(--surface); border: 1px solid var(--border); border-radius: 6px;
}
.action-bar .divider { width: 1px; height: 20px; background: var(--border-2); margin: 0 4px; }
.action-bar .label {
  font-size: 10px; font-weight: 600; text-transform: uppercase;
  letter-spacing: 0.6px; color: var(--text-3); margin-right: 4px;
}
.action-bar .spacer { flex: 1; }

/* SCORE DIST */
.dist-item { display: flex; align-items: center; gap: 8px; margin-bottom: 5px; }
.dist-item:last-child { margin-bottom: 0; }
.dist-label { font-family: 'JetBrains Mono', monospace; font-size: 10.5px; color: var(--text-3); width: 34px; }
.dist-track { flex: 1; height: 16px; background: var(--surface-2); border-radius: 3px; overflow: hidden; }
.dist-fill { height: 100%; background: var(--accent); border-radius: 3px; transition: width 0.3s ease; }
.dist-fill.hi { background: #16a34a; }
.dist-fill.mid { background: var(--accent); }
.dist-fill.lo { background: var(--warn); }
.dist-fill.bad { background: var(--danger); }
.dist-count { font-family: 'JetBrains Mono', monospace; font-size: 10.5px; color: var(--text-3); width: 26px; text-align: right; }

/* ACTIVITY LOG */
.activity {
  font-family: 'JetBrains Mono', monospace; font-size: 10.5px; line-height: 1.6;
  max-height: 260px; overflow-y: auto;
}
.act-row { display: flex; gap: 8px; padding: 1px 0; white-space: pre-wrap; word-break: break-all; }
.act-time { color: var(--text-4); flex-shrink: 0; }
.act-mod { color: var(--purple); flex-shrink: 0; }
.act-lv { flex-shrink: 0; width: 50px; font-weight: 500; }
.act-lv.INFO { color: var(--accent); }
.act-lv.WARNING { color: var(--warn); }
.act-lv.ERROR, .act-lv.CRITICAL { color: var(--danger); }
.act-lv.DEBUG { color: var(--text-4); }
.act-msg { color: var(--text-2); }

/* TABLE */
.tbl { width: 100%; border-collapse: collapse; font-size: 11.5px; }
.tbl thead th {
  text-align: left; padding: 8px 10px;
  font-size: 10px; font-weight: 600; text-transform: uppercase;
  letter-spacing: 0.7px; color: var(--text-3);
  border-bottom: 1px solid var(--border); background: var(--surface-2);
  position: sticky; top: 0; z-index: 1; white-space: nowrap;
}
.tbl thead th.sortable { cursor: pointer; user-select: none; }
.tbl thead th.sortable:hover { color: var(--text-2); }
.tbl thead th .sort-ind { color: var(--accent); margin-left: 3px; font-size: 9px; }
.tbl tbody td {
  padding: 7px 10px; border-bottom: 1px solid var(--border); color: var(--text-2);
  font-family: 'JetBrains Mono', monospace; font-size: 11px; white-space: nowrap;
}
.tbl tbody td.text { font-family: 'Inter', sans-serif; font-size: 11.5px; }
.tbl tbody tr { transition: background 0.08s; }
.tbl tbody tr:hover { background: var(--surface-2); }
.tbl tbody tr:last-child td { border-bottom: none; }

.score-pill {
  display: inline-block; padding: 1px 7px; border-radius: 3px;
  font-family: 'JetBrains Mono', monospace; font-size: 10.5px; font-weight: 600;
  min-width: 34px; text-align: center;
}
.score-pill.s10, .score-pill.s8 { background: var(--accent-soft); color: var(--accent); border: 1px solid var(--accent-line); }
.score-pill.s6 { background: var(--warn-soft); color: var(--warn); border: 1px solid var(--warn-line); }
.score-pill.s4 { background: var(--danger-soft); color: var(--danger); border: 1px solid var(--danger-line); }
.score-pill.s0 { background: var(--surface-2); color: var(--text-3); border: 1px solid var(--border-2); }

.verdict-pill {
  display: inline-block; padding: 1px 7px; border-radius: 3px;
  font-size: 10px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.4px;
}
.verdict-pill.approve, .verdict-pill.PASS { background: var(--accent-soft); color: var(--accent); }
.verdict-pill.revise, .verdict-pill.PASS_WITH_WARNINGS { background: var(--warn-soft); color: var(--warn); }
.verdict-pill.reject, .verdict-pill.error,
.verdict-pill.FAIL_DUPLICATE, .verdict-pill.FAIL_MISSING, .verdict-pill.FAIL_HALLUCINATED { background: var(--danger-soft); color: var(--danger); }
.verdict-pill.unknown, .verdict-pill.needs_review, .verdict-pill.exhausted { background: var(--surface-3); color: var(--text-3); }
.verdict-pill.L0_native { background: var(--accent-soft); color: var(--accent); }
.verdict-pill.L1_ocr { background: var(--info-soft); color: var(--info); }
.verdict-pill.L2_vlm { background: var(--purple-soft); color: var(--purple); }
.verdict-pill.L3_escalation { background: var(--warn-soft); color: var(--warn); }

.row-actions { display: flex; gap: 3px; justify-content: flex-end; }
.row-action {
  width: 22px; height: 22px; display: inline-flex; align-items: center; justify-content: center;
  background: transparent; border: 1px solid transparent; border-radius: 3px;
  color: var(--text-4); transition: all 0.1s;
}
.row-action:hover { color: var(--text); background: var(--surface-2); border-color: var(--border-2); }
.row-action.primary:hover { color: var(--accent); border-color: var(--accent-line); }
.row-action.danger:hover { color: var(--danger); border-color: var(--danger-line); }
.row-action svg { width: 12px; height: 12px; }

/* FILTER BAR */
.filter-bar { display: flex; gap: 6px; margin-bottom: 12px; align-items: center; flex-wrap: wrap; }
.filter-bar .input { width: 260px; }
.chips { display: flex; gap: 3px; flex-wrap: wrap; }
.chip {
  height: 28px; padding: 0 10px; font-size: 11px; font-weight: 500;
  color: var(--text-3); background: var(--surface-2); border: 1px solid var(--border-2);
  border-radius: 14px; transition: all 0.12s;
  display: inline-flex; align-items: center; gap: 5px;
}
.chip:hover { color: var(--text-2); border-color: var(--border-3); }
.chip.active { background: var(--accent-soft); color: var(--accent); border-color: var(--accent-line); }
.chip-count { font-family: 'JetBrains Mono', monospace; font-size: 10px; opacity: 0.8; }

/* TIMELINE */
.timeline { display: flex; align-items: flex-end; gap: 3px; height: 120px; padding: 8px 4px; border-bottom: 1px solid var(--border); }
.tl-bar {
  flex: 1; min-width: 4px; background: var(--accent); border-radius: 2px 2px 0 0;
  position: relative; transition: all 0.15s; opacity: 0.85; cursor: default;
}
.tl-bar:hover { opacity: 1; background: #16a34a; }
.tl-bar.today { background: var(--accent); box-shadow: 0 0 6px var(--accent-soft); opacity: 1; }
.tl-bar.zero { background: var(--surface-3); opacity: 0.5; }
.tl-labels {
  display: flex; gap: 3px; padding: 4px;
  font-family: 'JetBrains Mono', monospace; font-size: 9px; color: var(--text-4);
}
.tl-labels > span { flex: 1; min-width: 4px; text-align: center; }

/* LOG FULL */
.log-controls {
  display: flex; align-items: center; gap: 8px;
  padding: 10px 14px; border-bottom: 1px solid var(--border);
  background: var(--surface); flex-wrap: wrap;
}
.log-stats {
  display: flex; gap: 10px; margin-left: auto;
  font-family: 'JetBrains Mono', monospace; font-size: 10.5px;
}
.log-stat-item { display: flex; align-items: center; gap: 4px; color: var(--text-3); }
.log-stat-item .num { color: var(--text-2); font-weight: 500; }
.log-stat-item.INFO .num { color: var(--accent); }
.log-stat-item.WARNING .num { color: var(--warn); }
.log-stat-item.ERROR .num { color: var(--danger); }

.log-full {
  font-family: 'JetBrains Mono', monospace; font-size: 11px; line-height: 1.55;
  background: #060708; border-radius: 4px; padding: 10px 12px;
  max-height: calc(100vh - 320px); overflow: auto;
  position: relative;
}
.log-row {
  display: flex; gap: 8px; white-space: pre-wrap; word-break: break-all;
  padding: 1px 0;
}
.log-row:hover { background: rgba(255,255,255,0.02); }
.log-row.marked { background: var(--warn-soft); }
.log-t { color: var(--text-4); flex-shrink: 0; }
.log-mod {
  color: var(--purple); flex-shrink: 0; font-size: 10px;
  padding: 0 5px; background: var(--purple-soft); border-radius: 3px;
  height: 16px; display: inline-flex; align-items: center;
}
.log-lv {
  flex-shrink: 0; width: 54px; font-weight: 500;
  padding: 0 5px; border-radius: 3px; height: 16px;
  display: inline-flex; align-items: center; font-size: 10px;
}
.log-lv.INFO { color: var(--accent); background: var(--accent-soft); }
.log-lv.WARNING { color: var(--warn); background: var(--warn-soft); }
.log-lv.ERROR, .log-lv.CRITICAL { color: var(--danger); background: var(--danger-soft); }
.log-lv.DEBUG { color: var(--text-4); background: var(--surface-2); }
.log-m { color: var(--text-2); flex: 1; min-width: 0; }
.log-copy {
  opacity: 0;
  background: transparent;
  border: none;
  color: var(--text-4);
  padding: 1px 4px;
  border-radius: 3px;
  transition: all 0.12s;
  flex-shrink: 0;
}
.log-row:hover .log-copy { opacity: 1; }
.log-copy:hover { color: var(--accent); background: var(--surface-2); }
.log-copy svg { width: 11px; height: 11px; }
.log-row { position: relative; }

.log-scroll-btn {
  position: fixed; bottom: 30px; right: 30px; z-index: 50;
  width: 40px; height: 40px; border-radius: 50%;
  background: var(--accent); color: #052e16; border: none;
  display: flex; align-items: center; justify-content: center;
  box-shadow: 0 6px 20px rgba(34,197,94,0.4); cursor: pointer;
  transition: all 0.15s;
}
.log-scroll-btn:hover { transform: translateY(-2px); }
.log-scroll-btn.hide { display: none; }

/* EXTRACTION TAB */
.phase-pipeline {
  display: flex; align-items: stretch; gap: 0;
  background: var(--surface); border: 1px solid var(--border);
  border-radius: 6px; padding: 6px; margin-bottom: 12px;
  overflow-x: auto;
}
.phase-step {
  flex: 1; min-width: 150px; display: flex; align-items: center; gap: 10px;
  padding: 8px 12px; border-radius: 5px; position: relative;
  transition: background 0.12s;
}
.phase-step:hover { background: var(--surface-2); }
.phase-step:not(:last-child)::after {
  content: '›'; position: absolute; right: -8px; top: 50%;
  transform: translateY(-50%); color: var(--text-4);
  font-size: 14px; font-family: 'JetBrains Mono', monospace;
  pointer-events: none;
}
.phase-step + .phase-step { margin-left: 8px; }
.phase-num {
  width: 26px; height: 26px; display: flex; align-items: center; justify-content: center;
  border-radius: 50%; font-family: 'JetBrains Mono', monospace;
  font-size: 11px; font-weight: 600;
  background: var(--surface-2); border: 1px solid var(--border-2); color: var(--text-3);
  flex-shrink: 0;
}
.phase-step.done .phase-num { background: var(--accent-soft); border-color: var(--accent-line); color: var(--accent); }
.phase-step.running .phase-num { background: var(--warn-soft); border-color: var(--warn-line); color: var(--warn); animation: pulse 1.6s ease-in-out infinite; }
.phase-step.error .phase-num { background: var(--danger-soft); border-color: var(--danger-line); color: var(--danger); }
.phase-body { flex: 1; min-width: 0; }
.phase-name { font-size: 11.5px; font-weight: 600; color: var(--text); text-transform: capitalize; }
.phase-meta {
  font-family: 'JetBrains Mono', monospace; font-size: 10px; color: var(--text-3);
  margin-top: 1px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.phase-step.done .phase-name { color: var(--text-2); }

.progress-live {
  background: linear-gradient(90deg, var(--warn-soft), transparent);
  border: 1px solid var(--warn-line); border-radius: 6px;
  padding: 12px 14px; margin-bottom: 12px;
  display: flex; align-items: center; gap: 14px; flex-wrap: wrap;
}
.progress-live.idle { background: var(--surface); border-color: var(--border); }
.progress-live.error { background: linear-gradient(90deg, var(--danger-soft), transparent); border-color: var(--danger-line); }
.progress-live .pl-icon {
  width: 32px; height: 32px; border-radius: 6px;
  background: var(--warn-soft); border: 1px solid var(--warn-line); color: var(--warn);
  display: flex; align-items: center; justify-content: center; flex-shrink: 0;
}
.progress-live .pl-icon svg { width: 16px; height: 16px; }
.progress-live.idle .pl-icon { background: var(--surface-2); border-color: var(--border-2); color: var(--text-3); }
.progress-live.error .pl-icon { background: var(--danger-soft); border-color: var(--danger-line); color: var(--danger); }
.progress-live .pl-body { flex: 1; min-width: 200px; }
.progress-live .pl-title {
  font-size: 12px; font-weight: 600; color: var(--text);
  display: flex; align-items: center; gap: 8px;
}
.progress-live .pl-sub {
  font-family: 'JetBrains Mono', monospace; font-size: 10.5px; color: var(--text-3);
  margin-top: 2px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.progress-bar {
  width: 100%; height: 6px; background: var(--surface-3);
  border-radius: 3px; overflow: hidden; margin-top: 6px;
}
.progress-fill {
  height: 100%; background: linear-gradient(90deg, var(--warn), #fbbf24);
  border-radius: 3px; transition: width 0.4s ease;
}
.progress-live.idle .progress-fill { background: var(--accent); }

.breakdown-row {
  display: flex; align-items: center; gap: 8px;
  margin-bottom: 6px; font-size: 11px;
}
.breakdown-row:last-child { margin-bottom: 0; }
.breakdown-label {
  font-family: 'JetBrains Mono', monospace; font-size: 10.5px;
  color: var(--text-3); width: 130px; flex-shrink: 0;
}
.breakdown-track {
  flex: 1; height: 14px; background: var(--surface-2);
  border-radius: 3px; overflow: hidden;
}
.breakdown-fill {
  height: 100%; border-radius: 3px; transition: width 0.35s ease;
}
.breakdown-fill.pass { background: var(--accent); }
.breakdown-fill.warn { background: var(--warn); }
.breakdown-fill.fail { background: var(--danger); }
.breakdown-fill.unknown { background: var(--text-4); }
.breakdown-fill.l0 { background: var(--accent); }
.breakdown-fill.l1 { background: var(--info); }
.breakdown-fill.l2 { background: var(--purple); }
.breakdown-fill.l3 { background: var(--warn); }
.breakdown-fill.exhausted { background: var(--danger); }
.breakdown-count {
  font-family: 'JetBrains Mono', monospace; font-size: 10.5px;
  color: var(--text-2); width: 80px; text-align: right; flex-shrink: 0;
}

/* ACTION TILES */
.actions-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 8px; }
.action-tile {
  display: flex; align-items: center; gap: 10px;
  padding: 10px 12px; background: var(--surface-2);
  border: 1px solid var(--border-2); border-radius: 5px;
  cursor: pointer; transition: all 0.12s; text-align: left;
}
.action-tile:hover { background: var(--surface-3); border-color: var(--border-3); }
.action-tile:active { transform: translateY(1px); }
.action-tile:disabled { opacity: 0.4; cursor: not-allowed; }
.action-tile.loading { pointer-events: none; opacity: 0.6; }
.action-tile.loading .at-icon svg { animation: spin 0.8s linear infinite; }
.action-tile .at-icon {
  width: 28px; height: 28px; background: var(--surface);
  border: 1px solid var(--border-2); border-radius: 5px; color: var(--text-2);
  display: flex; align-items: center; justify-content: center; flex-shrink: 0;
}
.action-tile:hover .at-icon { color: var(--accent); border-color: var(--accent-line); }
.action-tile .at-icon svg { width: 14px; height: 14px; }
.action-tile .at-body { flex: 1; min-width: 0; }
.action-tile .at-name { font-size: 12px; font-weight: 600; color: var(--text); margin-bottom: 1px; }
.action-tile .at-desc { font-size: 10.5px; color: var(--text-3); line-height: 1.3; }
.action-tile.tile-primary { background: var(--accent-soft); border-color: var(--accent-line); }
.action-tile.tile-primary:hover { background: rgba(34,197,94,0.18); }
.action-tile.tile-primary .at-icon { background: var(--accent); border-color: var(--accent); color: #052e16; }
.action-tile.tile-danger { background: var(--danger-soft); border-color: var(--danger-line); }
.action-tile.tile-danger .at-icon { color: var(--danger); border-color: var(--danger-line); }

/* MODEL ROW */
.model-row {
  display: flex; align-items: center; gap: 10px;
  padding: 7px 0; border-bottom: 1px solid var(--border);
}
.model-row:last-child { border-bottom: none; }
.model-label {
  font-size: 10px; font-weight: 600; text-transform: uppercase;
  letter-spacing: 0.6px; color: var(--text-3); width: 90px; flex-shrink: 0;
}
.model-value {
  font-family: 'JetBrains Mono', monospace; font-size: 11px; color: var(--text-2);
  flex: 1; min-width: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.model-value.primary { color: var(--accent); }

/* PDF AUDIT VISUAL */
.audit-row-visual {
  display: flex; align-items: center; gap: 8px;
  padding: 6px 10px; border-bottom: 1px solid var(--border);
  transition: background 0.08s; cursor: pointer;
}
.audit-row-visual:hover { background: var(--surface-2); }
.audit-row-visual:last-child { border-bottom: none; }
.arv-name {
  flex: 0 0 240px; font-family: 'JetBrains Mono', monospace;
  font-size: 10.5px; color: var(--text-2);
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.arv-group {
  flex: 0 0 90px; font-family: 'JetBrains Mono', monospace;
  font-size: 10px; color: var(--purple);
  padding: 1px 6px; background: var(--purple-soft); border-radius: 3px;
  text-align: center; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.arv-pages {
  flex: 0 0 40px; font-family: 'JetBrains Mono', monospace;
  font-size: 10.5px; color: var(--text-3); text-align: right;
}
.arv-chart { flex: 1; min-width: 80px; height: 16px; display: flex; gap: 2px; }
.arv-chart .bar {
  flex: 1; border-radius: 2px; height: 100%;
  transition: all 0.15s;
}
.arv-chart .bar.easy { background: var(--accent); }
.arv-chart .bar.medium { background: #16a34a; }
.arv-chart .bar.hard { background: var(--warn); }
.arv-chart .bar.empty { background: var(--surface-3); }
.arv-problems {
  flex: 0 0 50px; font-family: 'JetBrains Mono', monospace;
  font-size: 10.5px; color: var(--text-2); text-align: right; font-weight: 500;
}
.arv-status {
  flex: 0 0 80px; font-size: 9.5px; font-weight: 600;
  padding: 2px 6px; border-radius: 3px; text-align: center;
  text-transform: uppercase; letter-spacing: 0.3px;
}
.arv-status.ok { background: var(--accent-soft); color: var(--accent); }
.arv-status.warn { background: var(--warn-soft); color: var(--warn); }
.arv-status.empty { background: var(--danger-soft); color: var(--danger); }

/* GROUP HEADER for audit */
.audit-group-header {
  display: flex; align-items: center; gap: 8px;
  padding: 8px 12px; background: var(--surface-2);
  border-bottom: 1px solid var(--border);
  position: sticky; top: 0; z-index: 2;
  font-size: 10.5px; font-weight: 600;
  color: var(--text-3); text-transform: uppercase; letter-spacing: 0.5px;
}
.audit-group-header .count {
  margin-left: auto; font-family: 'JetBrains Mono', monospace;
  color: var(--text-2);
}

/* POINT COVERAGE */
.point-coverage-grid {
  display: grid; grid-template-columns: repeat(auto-fill, minmax(70px, 1fr));
  gap: 4px;
}
.pc-cell {
  padding: 6px 4px; border-radius: 4px;
  background: var(--surface-2); border: 1px solid var(--border-2);
  text-align: center; cursor: pointer; transition: all 0.12s;
}
.pc-cell:hover { border-color: var(--accent-line); transform: translateY(-1px); }
.pc-cell.zero { opacity: 0.4; }
.pc-cell.few { background: var(--warn-soft); border-color: var(--warn-line); }
.pc-cell.many { background: var(--accent-soft); border-color: var(--accent-line); }
.pc-id { font-family: 'JetBrains Mono', monospace; font-size: 10px; font-weight: 600; color: var(--text); }
.pc-count { font-family: 'JetBrains Mono', monospace; font-size: 13px; font-weight: 600; margin-top: 2px; }
.pc-cell.zero .pc-count { color: var(--text-4); }
.pc-cell.few .pc-count { color: var(--warn); }
.pc-cell.many .pc-count { color: var(--accent); }

/* TOOL RESULT */
.tool-results-list { display: flex; flex-direction: column; gap: 8px; margin-bottom: 12px; }
.tool-result {
  background: var(--surface); border: 1px solid var(--border-2);
  border-radius: 6px; overflow: hidden;
}
.tool-result-h {
  padding: 8px 12px; background: var(--surface-2); border-bottom: 1px solid var(--border);
  display: flex; align-items: center; gap: 8px; font-size: 11px;
}
.tool-result-h .status-ok { color: var(--accent); }
.tool-result-h .status-err { color: var(--danger); }
.tool-result-h .meta {
  font-family: 'JetBrains Mono', monospace; font-size: 10px;
  color: var(--text-3); margin-left: 8px;
}
.tool-result-h .close-r {
  margin-left: auto; background: transparent; border: none;
  color: var(--text-3); padding: 3px; border-radius: 3px; transition: all 0.1s;
}
.tool-result-h .close-r:hover { color: var(--text); background: var(--surface-3); }
.tool-result-h .close-r svg { width: 14px; height: 14px; }
.tool-result-b {
  font-family: 'JetBrains Mono', monospace; font-size: 10.5px; line-height: 1.5;
  padding: 10px 12px; max-height: 500px; overflow: auto;
  white-space: pre-wrap; word-break: break-all;
  color: var(--text-2); background: #06070a;
}
.tool-result-b.tall { max-height: 700px; }
.tool-result-b.structured { white-space: normal; }
.tool-result-b table {
  width: 100%; border-collapse: collapse; font-size: 10.5px;
}
.tool-result-b table th {
  text-align: left; padding: 4px 8px; color: var(--text-3);
  font-size: 9.5px; font-weight: 600; text-transform: uppercase;
  letter-spacing: 0.4px; border-bottom: 1px solid var(--border);
}
.tool-result-b table td {
  padding: 4px 8px; border-bottom: 1px solid var(--border);
  color: var(--text-2);
}

/* EMPTY */
.empty {
  padding: 32px 16px; text-align: center;
  color: var(--text-4); font-size: 12px;
}
.empty svg { width: 24px; height: 24px; margin-bottom: 8px; opacity: 0.4; display: block; margin-left: auto; margin-right: auto; }
.empty-actions { margin-top: 10px; display: flex; gap: 6px; justify-content: center; flex-wrap: wrap; }

.skeleton-row {
  height: 32px;
  background: linear-gradient(90deg, var(--surface-2) 0%, var(--surface-3) 50%, var(--surface-2) 100%);
  background-size: 200% 100%; animation: shimmer 1.4s infinite;
  border-radius: 3px; margin-bottom: 4px;
}

/* TOOLS GROUPS */
.tools-groups {
  display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
  gap: 12px;
}
.tools-group {
  background: var(--surface); border: 1px solid var(--border);
  border-radius: 6px; overflow: hidden;
}
.tools-group-h {
  padding: 10px 14px; border-bottom: 1px solid var(--border);
  display: flex; align-items: center; gap: 8px;
  font-size: 11px; font-weight: 600; text-transform: uppercase;
  letter-spacing: 0.7px; color: var(--text-2);
}
.tools-group-h svg { width: 13px; height: 13px; color: var(--text-3); }
.tools-list { padding: 6px; }
.tool-item {
  display: flex; align-items: flex-start; gap: 10px;
  padding: 8px 10px; border-radius: 5px; cursor: pointer;
  transition: background 0.1s;
}
.tool-item:hover { background: var(--surface-2); }
.tool-item.loading { opacity: 0.5; pointer-events: none; }
.tool-icon {
  width: 28px; height: 28px; display: flex; align-items: center; justify-content: center;
  background: var(--surface-2); border: 1px solid var(--border-2);
  border-radius: 5px; color: var(--text-2); flex-shrink: 0;
}
.tool-icon svg { width: 14px; height: 14px; }
.tool-item:hover .tool-icon { color: var(--accent); border-color: var(--accent-line); }
.tool-item.loading .tool-icon svg { animation: spin 0.8s linear infinite; }
.tool-info { flex: 1; min-width: 0; }
.tool-name {
  font-size: 12px; font-weight: 500; color: var(--text);
  display: flex; align-items: center; gap: 6px; margin-bottom: 2px;
}
.tool-desc { font-size: 11px; color: var(--text-3); line-height: 1.4; }
.tool-cost {
  font-size: 9.5px; font-weight: 600; padding: 1px 5px;
  border-radius: 3px; text-transform: uppercase; letter-spacing: 0.3px;
}
.tool-cost.free { background: var(--accent-soft); color: var(--accent); }
.tool-cost.paid { background: var(--warn-soft); color: var(--warn); }

/* TOAST */
.toast {
  position: fixed; bottom: 20px; right: 20px; min-width: 260px; max-width: 500px;
  padding: 11px 14px; background: var(--surface); border: 1px solid var(--border-2);
  border-left: 3px solid var(--accent); border-radius: 6px;
  box-shadow: 0 12px 32px rgba(0,0,0,0.6);
  display: flex; gap: 10px; align-items: flex-start;
  opacity: 0; transform: translateY(10px); pointer-events: none;
  transition: all 0.22s ease; z-index: 100;
}
.toast.show { opacity: 1; transform: translateY(0); pointer-events: auto; }
.toast.error { border-left-color: var(--danger); }
.toast svg { width: 15px; height: 15px; flex-shrink: 0; margin-top: 1px; }
.toast.error > svg { color: var(--danger); }
.toast:not(.error) > svg { color: var(--accent); }
.toast-content { flex: 1; min-width: 0; }
.toast-title { font-weight: 600; font-size: 12px; margin-bottom: 2px; }
.toast-text {
  font-family: 'JetBrains Mono', monospace; font-size: 10.5px; color: var(--text-3);
  white-space: pre-wrap; max-height: 100px; overflow-y: auto; word-break: break-all;
}

/* SCROLLBARS */
* { scrollbar-width: thin; scrollbar-color: var(--border-2) transparent; }
*::-webkit-scrollbar { width: 8px; height: 8px; }
*::-webkit-scrollbar-track { background: transparent; }
*::-webkit-scrollbar-thumb { background: var(--border-2); border-radius: 4px; }
*::-webkit-scrollbar-thumb:hover { background: var(--text-4); }

/* RESPONSIVE */
@media (max-width: 1200px) {
  .g3 { grid-template-columns: 1fr 1fr; }
  .g1-2, .g2-1 { grid-template-columns: 1fr; }
  .kpis.k4 { grid-template-columns: repeat(2, 1fr); }
  .phase-pipeline { flex-wrap: wrap; }
  .phase-step { min-width: 140px; }
  .phase-step:not(:last-child)::after { display: none; }
}
@media (max-width: 900px) {
  .kpis, .kpis.k4, .kpis.k3 { grid-template-columns: repeat(2, 1fr); }
  .g2 { grid-template-columns: 1fr; }
  .g3 { grid-template-columns: 1fr; }
  .tab { padding: 6px 10px; }
  .tab span.tab-label { display: none; }
  .hdr { padding: 0 12px; gap: 10px; }
  .main { padding: 12px; }
  .actions-grid { grid-template-columns: 1fr; }
  .filter-bar .input { width: 100%; }
}
</style>
</head>
<body>

<header class="hdr">
  <div class="hdr-brand">
    <i data-lucide="activity"></i>
    <span>PIPELINE</span>
  </div>

  <nav class="tabs" role="tablist">
    <button class="tab active" data-tab="overview"><i data-lucide="layout-dashboard"></i><span class="tab-label">Overview</span></button>
    <button class="tab" data-tab="extraction"><i data-lucide="layers"></i><span class="tab-label">Extraction</span><span class="tab-badge" id="tabExtractionBadge">—</span></button>
    <button class="tab" data-tab="articles"><i data-lucide="file-text"></i><span class="tab-label">Articles</span><span class="tab-badge" id="tabArticlesBadge">—</span></button>
    <button class="tab" data-tab="costs"><i data-lucide="dollar-sign"></i><span class="tab-label">Costs</span></button>
    <button class="tab" data-tab="provider"><i data-lucide="cloud"></i><span class="tab-label">Provider</span></button>
    <button class="tab" data-tab="logs"><i data-lucide="terminal"></i><span class="tab-label">Logs</span><span class="tab-badge" id="tabLogsBadge">—</span></button>
    <button class="tab" data-tab="tools"><i data-lucide="wrench"></i><span class="tab-label">Tools</span></button>
  </nav>

  <div class="hdr-right">
    <div class="status" id="status"><span class="dot"></span><span id="statusText">Connecting</span></div>
    <a class="hdr-link" href="/" target="_blank"><i data-lucide="arrow-up-right"></i> Site</a>
  </div>
</header>

<main class="main">

  <!-- OVERVIEW -->
  <section class="tab-panel active" id="tab-overview">
    <div class="orch action-bar">
      <button class="btn primary" id="btnStart" onclick="onStart(this)"><i data-lucide="play"></i> Start</button>
      <button class="btn danger" id="btnStop" onclick="onStop(this)" disabled><i data-lucide="square"></i> Stop</button>
      <button class="btn" id="btnOnce" onclick="onOnce(this)"><i data-lucide="zap"></i> Run Once</button>
      <span class="divider"></span>
      <input type="text" class="input mono" id="pointInput" placeholder="2.1" style="width:70px;">
      <button class="btn" onclick="onPointTool(this,'verify')"><i data-lucide="shield-check"></i> Verify</button>
      <button class="btn" onclick="onPointTool(this,'recover')"><i data-lucide="rotate-ccw"></i> Recover</button>
      <span class="spacer"></span>
      <span class="mono" style="font-size:10.5px;color:var(--text-3)">PID <strong id="mPid" style="color:var(--text-2)">—</strong></span>
      <span class="mono" style="font-size:10.5px;color:var(--text-3)">UPTIME <strong id="mUptime" style="color:var(--text-2)">—</strong></span>
      <span class="mono" style="font-size:10.5px;color:var(--text-3)">BUDGET <strong id="mBudget" style="color:var(--text-2)">—</strong></span>
    </div>

    <div class="kpis">
      <div class="kpi">
        <div class="kpi-h"><i data-lucide="check-circle-2"></i>Done</div>
        <div class="kpi-v" id="kDone">—</div>
        <div class="kpi-s" id="kDoneSub">of —</div>
      </div>
      <div class="kpi">
        <div class="kpi-h"><i data-lucide="clock"></i>Pending</div>
        <div class="kpi-v warn" id="kPending">—</div>
        <div class="kpi-s" id="kPendingSub">in queue</div>
      </div>
      <div class="kpi">
        <div class="kpi-h"><i data-lucide="alert-triangle"></i>Errors</div>
        <div class="kpi-v danger" id="kErrors">—</div>
        <div class="kpi-s" id="kErrorsSub">needs attention</div>
      </div>
      <div class="kpi">
        <div class="kpi-h"><i data-lucide="trending-up"></i>Avg Score</div>
        <div class="kpi-v accent" id="kScore">—</div>
        <div class="kpi-s" id="kScoreSub">—</div>
      </div>
      <div class="kpi">
        <div class="kpi-h"><i data-lucide="circle-dollar-sign"></i>Spent Today</div>
        <div class="kpi-v" id="kSpent">—</div>
        <div class="kpi-s" id="kSpentSub">of $3.00</div>
      </div>
    </div>

    <div id="extractionPulse"></div>

    <div class="grid g2 mb12">
      <div class="card">
        <div class="card-h">
          <i data-lucide="bar-chart-2"></i>
          <span class="card-title">Score Distribution</span>
          <span class="updated" id="distUpdated"></span>
          <span class="card-badge" id="distBadge">—</span>
        </div>
        <div class="card-body" id="distBody">
          <div class="empty"><i data-lucide="bar-chart-2"></i>No scores yet</div>
        </div>
      </div>
      <div class="card">
        <div class="card-h">
          <i data-lucide="radio"></i>
          <span class="card-title">Live Activity</span>
          <span class="updated" id="activityUpdated"></span>
          <span class="card-badge" id="activityBadge">—</span>
        </div>
        <div class="card-body" style="padding:8px 12px">
          <div class="activity" id="activityLog">
            <div class="empty" style="padding:20px 0;font-size:11px">Waiting for log…</div>
          </div>
        </div>
      </div>
    </div>

    <div class="grid g2">
      <div class="card">
        <div class="card-h">
          <i data-lucide="clock"></i>
          <span class="card-title">Recent Articles</span>
          <span class="card-badge" id="recentBadge">—</span>
        </div>
        <div class="card-body flush" style="max-height:280px;overflow:auto">
          <table class="tbl" id="recentTable">
